{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/attendance",
      "destination": "/attendance.html"
    },
    {
      "source": "/special-lecture",
      "destination": "/special-lecture.html"
    },
    {
      "source": "/special-lecture/",
      "destination": "/special-lecture.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
