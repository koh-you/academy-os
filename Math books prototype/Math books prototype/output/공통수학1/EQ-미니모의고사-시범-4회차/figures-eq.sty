\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% 정의된 색상이 없으면 새로 정의
\providecommand{\paramcasecolor}{vB-light}
\providecommand{\paramcasebordercolor}{vB-rule}

% \paramcase{기준 조건}{경우 1}{경우 2} — 2분기
\newcommand{\paramcase}[3]{%
  \par\smallskip\noindent
  \begin{tcolorbox}[enhanced, breakable, colback=white, colframe=vB-rule,
    boxrule=0.5pt, arc=2pt, left=8pt, right=8pt, top=4pt, bottom=4pt,
    fontupper=\small]
    \textbf{기준}: #1\par\smallskip
    \textbullet\ \textit{경우 1}: #2\par
    \textbullet\ \textit{경우 2}: #3
  \end{tcolorbox}%
}

% \paramcasethree{기준}{경우 1}{경우 2}{경우 3} — 3분기
\newcommand{\paramcasethree}[4]{%
  \par\smallskip\noindent
  \begin{tcolorbox}[enhanced, breakable, colback=white, colframe=vB-rule,
    boxrule=0.5pt, arc=2pt, left=8pt, right=8pt, top=4pt, bottom=4pt,
    fontupper=\small]
    \textbf{기준}: #1\par\smallskip
    \textbullet\ \textit{경우 1}: #2\par
    \textbullet\ \textit{경우 2}: #3\par
    \textbullet\ \textit{경우 3}: #4
  \end{tcolorbox}%
}
