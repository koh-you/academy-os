\dmsection[스스로 풀어보기]{확인 문제}

\renewcommand{\dmquickgridstretch}{2.25}
\begin{dmquickgrid}
\dmquick{1}{$a+b+r^2=14$} & \dmquick{2}{$a+b+c=-3$} & \dmquick{3}{$r=3$, 중심 $(3,-3)$} & \dmquick{4}{정수 $a$: $3$\ 개} & \dmquick{5}{$-2<k<2$} \\
\dmquick{6}{$k=20$} & \dmquick{7}{$y$\ 절편의 곱 $=-25$} & \dmquick{8}{기울기 곱 $=-\dfrac{5}{4}$} & \dmquick{9}{$M^2+m^2=84$} & \dmquick{10}{$5\sqrt{2}+1$} \\
% CHK2·CHK8 quickgrid 값 이미 -3 · -5/4로 확정 (Phase 4 재검증 완료)
\dmquick{11}{넓이 $=10\pi$} & \dmquick{12}{둘레 $=6\pi$} & & & \\
