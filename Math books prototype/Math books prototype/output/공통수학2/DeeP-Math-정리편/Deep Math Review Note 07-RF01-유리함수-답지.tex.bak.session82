\dmsection[스스로 풀어보기]{확인 문제}

\renewcommand{\dmquickgridstretch}{2.25}
\begin{dmquickgrid}
\dmquick{1}{풀이 참조} & \dmquick{2}{$-1$} & \dmquick{3}{$\dfrac{4}{13}$} & \dmquick{4}{$\dfrac{4}{x(x+4)}$} & \dmquick{5}{풀이 참조} \\
\dmquick{6}{$-18$} & \dmquick{7}{max $\dfrac{1}{3}$·min $-3$} & \dmquick{8}{$12$} & \dmquick{9}{$1$} & \dmquick{10}{$8$} \\
\dmquick{11}{$3$} & \dmquick{12}{$3$} & & & \\
\end{dmquickgrid}

\begin{multicols*}{2}

% ─────────────── 확인 1 ───────────────
\dmsoltitle{1}{유리식의 사칙연산}
\begin{dmanslist}
\dmansitem{1} $\dfrac{5x+12}{(x+2)(x+3)}$ \\
& \dmansitem{2} $\dfrac{x+2}{2x^{2}}$
\end{dmanslist}

\dmsubprob{1} 공통분모 $(x+2)(x+3)$\ 로 통분하면
\[ \dfrac{2(x+3)+3(x+2)}{(x+2)(x+3)}=\dfrac{5x+12}{(x+2)(x+3)}. \]

\dmsubprob{2} 첫 분수의 분모 $x^{2}+3x=x(x+3)$\ 로 인수분해 후 공통인수를 소거하면
\[ \dfrac{x+2}{x(x+3)}\times\dfrac{x+3}{2x}=\dfrac{x+2}{2x^{2}}. \]

% ─────────────── 확인 2 ───────────────
\dmsoltitle{2}{부분분수 분해와 계수 결정}
\begin{dmanswerbox}
정답: $-1$
\end{dmanswerbox}

우변을 통분한 분자 $a(x+1)+b(x-2)$\ 가 $5x-4$\ 와 같아야 한다. $x=2$\ 에서 $6=3a$\ 이므로 $a=2$, $x=-1$\ 에서 $-9=-3b$\ 이므로 $b=3$. 따라서 $a-b=-1$\ 이다.

\begin{dmcriticalpoint}
\dmcplabel{분모의 근을 대입하면 상수가 결정된다}: 부분분수 항등식은 통분 후 분자에서 항등식이 성립하므로, 분모의 각 근을 대입하면 남은 상수가 즉시 얻어진다.
\end{dmcriticalpoint}

% ─────────────── 확인 3 ───────────────
\dmsoltitle{3}{인접 항이 상쇄되는 유한 합}
\begin{dmanswerbox}
정답: $\dfrac{4}{13}$
\end{dmanswerbox}

분모가 공차 $3$\ 인 두 수의 곱이므로
\[ \dfrac{1}{(3k-2)(3k+1)}=\dfrac{1}{3}\!\left(\dfrac{1}{3k-2}-\dfrac{1}{3k+1}\right) \]
로 분해된다. 이를 적용하면 이웃한 항들이 소거되어 첫 항 $1$\ 과 마지막 항 $-\dfrac{1}{13}$\ 만 남으므로
\[ \dfrac{1}{3}\!\left(1-\dfrac{1}{13}\right)=\dfrac{4}{13}. \]

% ─────────────── 확인 4 ───────────────
\dmsoltitle{4}{연속된 곱꼴에서 인접 항의 상쇄}
\begin{dmanswerbox}
정답: $\dfrac{4}{x(x+4)}$
\end{dmanswerbox}

각 항을 부분분수 분해하면
\[ \dfrac{1}{k(k+1)}=\dfrac{1}{k}-\dfrac{1}{k+1} \]
이므로 주어진 합은 이웃한 항들이 모두 소거되어 첫 항 $\dfrac{1}{x}$\ 와 마지막 항 $-\dfrac{1}{x+4}$\ 만 남는다. 따라서
\[ \dfrac{1}{x}-\dfrac{1}{x+4}=\dfrac{(x+4)-x}{x(x+4)}=\dfrac{4}{x(x+4)}. \]

% ─────────────── 확인 5 ───────────────
\dmsoltitle{5}{일반형에서 표준형으로 변형해 정의역·치역·점근선 결정}
\begin{dmanswerbox}
정답: $x\ne -3$,\ $y\ne -2$,\ 점근선 $x=-3$,\ $y=-2$
\end{dmanswerbox}

분자를 분모로 나누면
\[ y=\dfrac{-2x+1}{x+3}=\dfrac{-2(x+3)+7}{x+3}=\dfrac{7}{x+3}-2. \]
표준형에서 대칭 중심이 $(-3,\, -2)$\ 이므로 정의역은 $x\ne -3$\ 인 실수 전체, 치역은 $y\ne -2$\ 인 실수 전체이고, 두 점근선은 $x=-3$\ 과 $y=-2$\ 이다.

% ─────────────── 확인 6 ───────────────
\dmsoltitle{6}{평행이동한 그래프의 식과 계수 매칭}
\begin{dmanswerbox}
정답: $-18$
\end{dmanswerbox}

$y=-\dfrac{3}{x}$\ 를 $x$\ 축 방향으로 $3$\ 만큼, $y$\ 축 방향으로 $-2$\ 만큼 평행이동하면
\[ y=-\dfrac{3}{x-3}-2=\dfrac{-3-2(x-3)}{x-3}=\dfrac{-2x+3}{x-3}. \]
이 식이 $y=\dfrac{ax+b}{x-c}$\ 이므로 $a=-2$,\ $b=3$,\ $c=3$\ 이고
\[ abc=(-2)\cdot 3\cdot 3=-18. \]

% ─────────────── 확인 7 ───────────────
\dmsoltitle{7}{폐구간 유리함수의 최댓값·최솟값}
\begin{dmanswerbox}
정답: 최댓값 $\dfrac{1}{3}$, 최솟값 $-3$
\end{dmanswerbox}

$y=\dfrac{2x-3}{x+1}=\dfrac{2(x+1)-5}{x+1}=2-\dfrac{5}{x+1}$\ 이다. 대칭 중심 $(-1,\, 2)$\ 의 오른쪽 구간에 있는 $0\le x\le 2$\ 에서 $\dfrac{5}{x+1}$\ 이 감소하므로 $y$\ 는 증가한다.

경계값을 대입하면
\[ x=0:\ y=2-5=-3,\quad x=2:\ y=2-\dfrac{5}{3}=\dfrac{1}{3}. \]
따라서 최솟값은 $-3$, 최댓값은 $\dfrac{1}{3}$\ 이다.

% ─────────────── 확인 8 ───────────────
\dmsoltitle{8}{조건에서 얻는 상수의 합}
\begin{dmanswerbox}
정답: $12$
\end{dmanswerbox}

$y=\dfrac{3x+k}{x+2}=\dfrac{k-6}{x+2}+3$\ 에서 $k>6$\ 이므로 $k-6>0$\ 이고, 이 함수는 $x>-2$\ 에서 감소한다. 폐구간 $0\le x\le a$\ 가 $-2$\ 의 오른쪽에 있으므로 최댓값은 $x=0$\ 에서, 최솟값은 $x=a$\ 에서 나타난다.

$x=0$\ 에서
\[ \dfrac{k-6}{2}+3=5\quad\therefore\ k=10. \]
$x=a$\ 에서
\[ \dfrac{3a+10}{a+2}=4\quad\therefore\ a=2. \]
$\therefore\ a+k=12$.

\begin{dmcriticalpoint}
\dmcplabel{분자 상수의 부호가 증감을 결정한다}: 표준형의 분자 상수 부호로 함수의 증감이 정해지므로, 폐구간의 어느 끝점에서 최댓값과 최솟값이 나타나는지 이 부호로 판단한다.
\end{dmcriticalpoint}

% ─────────────── 확인 9 ───────────────
\dmsoltitle{9}{대칭 중심의 좌표 합}
\begin{dmanswerbox}
정답: $1$
\end{dmanswerbox}

$y=\dfrac{5x+6}{2x+3}=\dfrac{5}{2}-\dfrac{3}{2(2x+3)}$\ 이므로 두 점근선은 $x=-\dfrac{3}{2}$\ 와 $y=\dfrac{5}{2}$\ 이다. 대칭 중심은 두 점근선의 교점이므로
\[ (a,\, b)=\left(-\dfrac{3}{2},\ \dfrac{5}{2}\right),\qquad a+b=-\dfrac{3}{2}+\dfrac{5}{2}=1. \]

% ─────────────── 확인 10 ───────────────
% 세션 73 : 그래프 추가 (feedback_solution_graph_requirement · 유형 5 대칭)
%   골든 : templates/tikz-graph-golden/curve-line-intersection.tex 계승
%   scale=0.7 · 두 대칭축 + 교점 시각화
\dmsoltitle{10}{두 직선의 교점이 대칭 중심}
\begin{dmanswerbox}
정답: $8$
\end{dmanswerbox}

\begin{center}
\begin{tikzpicture}[scale=1.0]
  % ── 세션 77 : 프레임-곡선 여백 재조정 (feedback_figure_frame_screen_fill)
  %   이전: x[-4.5,1.5] y[-1.5,3.5] · 좌 branch가 x=-4.5 프레임 좌변까지 도달 → 여백 0%
  %   정정: x[-5.0,2.0] 확장 · 좌 branch domain [-4.2,-2.5] · 우 branch [-1.5,1.5] · 여백 확보
  %   변환: y=x+6 → y_c=x_c+3 · y=-x-2 → y_c=-x_c-1 · 교점 (-4,2) → (-2,1)
  %   유리함수 y=(2x+3)/(x+4) → 압축 y_c=(4x_c+3)/(4x_c+8) · 점근선 x_c=-2·y_c=1
  \draw[-stealth, black, line width=0.7pt] (-5.0, 0) -- (2.0, 0) node[below, font=\scriptsize] {$x$};
  \draw[-stealth, black, line width=0.7pt] (0, -2.0) -- (0, 4.0) node[left, font=\scriptsize] {$y$};
  \node[font=\scriptsize, above right] at (0, 0) {O};
  \node[font=\tiny, below] at (-2, -0.02) {$-4$};
  \node[font=\tiny, left] at (-0.02, 1) {$2$};
  % ── 두 대칭축 · 축 프레임 좌우 전체 채움 · clip
  \begin{scope}
    \clip (-5.0, -2.0) rectangle (2.0, 4.0);
    % y = x+6 → 압축 y_c = x_c + 3 (점선)
    \draw[dm-accent, line width=0.4pt, dash pattern=on 2pt off 1.5pt] (-5.0, -2.0) -- (2.0, 5.0);
    % y = -x-2 → 압축 y_c = -x_c - 1 (점선)
    \draw[dm-accent, line width=0.4pt, dash pattern=on 2pt off 1.5pt] (-5.0, 4.0) -- (2.0, -3.0);
  \end{scope}
  % ── 유리함수 곡선 y_c=(4x_c+3)/(4x_c+8) · 실효 0.5pt · 검정 실선
  %   좌 branch (x_c ∈ [-4.2, -2.5]) : y_c ∈ [1.61, 3.5] · 좌 여백 0.8단위 (16%)
  \draw[black, line width=0.5pt, domain=-4.2:-2.5, samples=80]
    plot (\x, {(4*\x + 3) / (4*\x + 8)});
  %   우 branch (x_c ∈ [-1.5, 1.5]) : y_c ∈ [-1.5, 0.64] · 우 여백 0.5단위 (25%)
  \draw[black, line width=0.5pt, domain=-1.5:1.5, samples=80]
    plot (\x, {(4*\x + 3) / (4*\x + 8)});
  % ── 대칭축 라벨 (곡선·다른 대칭축 회피 · 별도 node 배치)
  \node[font=\tiny, dm-accent, anchor=south east] at (1.9, 3.55) {$y=x+6$};
  \node[font=\tiny, dm-accent, anchor=north east] at (1.9, -1.55) {$y=-x-2$};
  % ── 곡선 라벨 (좌하 영역 · 좌 branch 근처)
  \node[font=\tiny, black, anchor=north west] at (-4.1, 1.6) {$y=f(x)$};
  % ── 교점 (-4, 2) → 압축 (-2, 1) · 대칭 중심 · 정점 0.8pt
  \filldraw[black] (-2, 1) circle (0.8pt);
\end{tikzpicture}
\end{center}

두 대칭축 $y=x+6$\ 과 $y=-x-2$\ 의 교점은
\[ x+6=-x-2,\quad 2x=-8,\quad x=-4,\quad y=2 \]
이므로 대칭 중심은 $(-4,\, 2)$\ 이다.

한편 $y=\dfrac{bx+3}{x+a}$\ 의 대칭 중심은 두 점근선 $x=-a$\ 와 $y=b$\ 의 교점 $(-a,\, b)$\ 이다. 두 좌표를 비교하면 $a=4$,\ $b=2$\ 이므로
\[ ab=4\cdot 2=8. \]

% 세션 75 : 그래프 추가 (feedback_solution_graph_requirement · 유형 5 · 자기역함수)
%   골든 : inverse-symmetry.tex 응용 · scale=1.0 · 좌표 0.5배 압축
%   f(x)=(2x+1)/(x-2) · 점근선 x=2·y=2 · y=x 대칭이 자기 자신
% ─────────────── 확인 11 ───────────────
\dmsoltitle{11}{역함수가 자기 자신과 같은 경우의 함수 합성}
\begin{dmanswerbox}
정답: $3$
\end{dmanswerbox}

$(f \circ g)(x) = x$\ 에서 $g = f^{-1}$\ 이므로, $y = f(x)$\ 의 그래프가 $y = x$\ 에 대칭인지를 먼저 확인한다.

\begin{center}
\begin{tikzpicture}[scale=1.0]
  % ── 세션 77 : 프레임 축소·곡선 domain 확장으로 활용률 상승 (tikz-graph-quality D3)
  %   이전: x[-1.5,3.8] y[-3.5,5.7] · 좌 branch [-1.4,0.7]·우 branch [1.3,3.5]
  %   정정: x[-1.2,3.5] y[-3.0,5.2] · 좌 branch [-1.1,0.8]·우 branch [1.2,3.3] · 활용률 65%↑
  \draw[-stealth, black, line width=0.7pt] (-1.2, 0) -- (3.5, 0) node[below, font=\scriptsize] {$x$};
  \draw[-stealth, black, line width=0.7pt] (0, -3.0) -- (0, 5.2) node[left, font=\scriptsize] {$y$};
  \node[font=\scriptsize, below left] at (0, 0) {O};
  \node[font=\tiny, below] at (1, -0.02) {$2$};
  \node[font=\tiny, left] at (-0.02, 1) {$2$};
  % ── 점근선 x=2·y=2 → 압축 x=1·y=1 (얇은 점선 · 각 라인 별도 \draw)
  \draw[gray, line width=0.4pt, dash pattern=on 1.5pt off 1.5pt] (1, -3.0) -- (1, 5.2);
  \draw[gray, line width=0.4pt, dash pattern=on 1.5pt off 1.5pt] (-1.2, 1) -- (3.5, 1);
  % ── 원함수·역함수 (자기 자신) · f(x)=(2x+1)/(x-2) → 압축 y_c=(4x_c+1)/(4x_c-4)
  %   왼쪽 branch (x_c ∈ [-1.1, 0.8]) : y_c ∈ [0.48, -4.2] (하단 -3.0 프레임 clip)
  \draw[black, line width=0.5pt, domain=-1.1:0.8, samples=80]
    plot (\x, {(4*\x + 1) / (4*\x - 4)});
  %   오른쪽 branch (x_c ∈ [1.2, 3.3]) : y_c ∈ [7.25, 1.68] (상단 5.2 프레임 clip)
  \begin{scope}
    \clip (-1.2, -3.0) rectangle (3.5, 5.2);
    \draw[black, line width=0.5pt, domain=1.2:3.3, samples=80]
      plot (\x, {(4*\x + 1) / (4*\x - 4)});
  \end{scope}
  \node[font=\tiny, anchor=south west] at (2.6, 1.6) {$y=f(x)$};
  % ── y = x 대각선 · 점선 dm-accent 0.4pt · 프레임 좌우 채움
  \begin{scope}
    \clip (-1.2, -3.0) rectangle (3.5, 5.2);
    \draw[dm-accent, line width=0.4pt, dash pattern=on 2pt off 1.5pt]
      (-1.2, -1.2) -- (3.5, 3.5);
  \end{scope}
  \node[font=\tiny, dm-accent, anchor=south west] at (3.1, 3.2) {$y=x$};
\end{tikzpicture}
\end{center}

$y = \dfrac{2x+1}{x-2}$\ 에서 $x$\ 와 $y$\ 를 바꾼 뒤 $y$\ 에 대하여 풀면 $x(y-2)=2y+1$\ 에서 $y=\dfrac{2x+1}{x-2}$\ 이므로 $f^{-1}(x)=f(x)$\ 이다. 즉 $g=f$\ 이므로 $g(3)$\ 부터 순차 계산하면
$$g(3)=\dfrac{7}{1}=7,\qquad g(7)=\dfrac{15}{5}=3$$
$\therefore\ (g \circ g)(3)=g(7)=3$.

\begin{dmcriticalpoint}
\dmcplabel{$a+d=0$\ 이면 역함수가 자기 자신}: 유리함수 $\dfrac{ax+b}{cx+d}$\ 의 계수가 $a+d=0$\ 이면 $f^{-1}=f$\ 이므로 두 번 합성이 항등함수가 되어 임의의 값이 그대로 돌아온다.
\end{dmcriticalpoint}

% ─────────────── 확인 12 ───────────────
\dmsoltitle{12}{반복 합성과 주기}
\begin{dmanswerbox}
정답: $3$
\end{dmanswerbox}

$f(3)=\dfrac{3-2}{3-1}=\dfrac{1}{2}$\ 이고 $f\!\left(\dfrac{1}{2}\right)=\dfrac{\dfrac{1}{2}-2}{\dfrac{1}{2}-1}=\dfrac{-3/2}{-1/2}=3$\ 이다. 따라서 $f^{2}(3)=3$\ 이므로 $f$\ 는 값 $3$\ 을 주기 $2$\ 로 순환시킨다.
\[ f^{2024}(3)=(f^{2})^{1012}(3)=3. \]

\end{multicols*}

