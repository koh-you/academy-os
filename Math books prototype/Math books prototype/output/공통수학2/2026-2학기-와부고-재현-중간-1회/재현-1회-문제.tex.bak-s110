% ── \probpairfullheight 는 style.sty 기본값 215mm 를 그대로 쓴다 ──
%   🔴 226mm 로 늘려 보았다 (컬럼 위끝 19.0mm · 꼬리말 줄 245.1mm → 쓸 수 있는 높이 226.1mm).
%      비는 1.14 에서 1.02 로 좋아졌으나 쪽수가 7 에서 10 으로 늘고 빌드 오류 3건이 났다.
%      컬럼이 넘친 것이므로 되돌렸다. 남는 11mm 는 페이지 하단 여백으로 둔다.

\begin{document}

\examheader{도형의 방정식 \textperiodcentered\ 집합과 명제}{총 17문 \textperiodcentered\ 100점}

% 구간 표시는 examheader (7)행에 통합 — \examsection 배지 폐기 (마스터 확정 2026-07-30)

% ══════════════════════════════════════════════════════════════════════════
% 페이지 1 (선택형 Q1~Q4) · examheader 동반 페이지
% 옵션 A 세로 컬럼 (\pagecolumnpair): 좌 {1,2} · 우 {3,4} · 각 컬럼 \vfill 균등 분배
% ══════════════════════════════════════════════════════════════════════════
\begin{pagepair}
\pagecolumnpair{%
\begin{problem}{1}{s}
세 점 $\mathrm{A}(2,\,-1)$, $\mathrm{B}(8,\,5)$, $\mathrm{C}(5,\,8)$에 대하여 삼각형 $\mathrm{ABC}$의 무게중심을 $\mathrm{G}$라 하고, 선분 $\mathrm{AB}$를 $2:1$로 내분하는 점을 $\mathrm{P}$라 하자. 두 점 $\mathrm{G}$, $\mathrm{P}$를 지나는 직선의 $x$절편은? \pts{4.5}
\begin{choices}
\choice{$1$}
\choice{$3$}
\choice{$5$}
\choice{$6$}
\choice{$9$}
\end{choices}
\end{problem}

\vfill

\begin{problem}{2}{s}
$x$, $y$에 대한 방정식 $x^{2}+y^{2}-2ax-2ay+3a^{2}-a-6=0$이 원을 나타내도록 하는 정수 $a$의 개수는? \pts{4.6}
\begin{choices}
\choice{$3$}
\choice{$4$}
\choice{$5$}
\choice{$6$}
\choice{$7$}
\end{choices}
\end{problem}
}{%
\begin{problem}{3}{s}
전체집합 $U$의 세 부분집합 $A$, $B$, $C$에 대하여 $(A\cup B)\subset C$가 성립할 때, 집합 $\{(C-A)\cup(C-B)\}^{c}\cap C$와 항상 같은 집합은? \pts{4.7}
\begin{choices}
\choice{$A\cap B$}
\choice{$A\cup B$}
\choice{$B-A$}
\choice{$C-B$}
\choice{$\varnothing$}
\end{choices}
\end{problem}

\vfill

\begin{problem}{4}{s}
좌표평면 위의 두 점 $\mathrm{A}(0,\,4)$, $\mathrm{B}(4,\,0)$과 점 $\mathrm{P}(x,\,y)$에 대하여 다음 〈보기〉에서 옳은 것을 모두 고른 것은? \pts{4.8}
\vspace{2mm}

\begin{bogibox}
ㄱ. $x^{2}+y^{2}=2xy$는 $x=y$이기 위한\\[1pt]
\hphantom{ㄱ. }\nob{필요충분조건이다.}\\[2pt]
ㄴ. 점 $\mathrm{P}$가 선분 $\mathrm{AB}$의 중점인 것은\\[1pt]
\hphantom{ㄴ. }\nob{$x=y$이기 위한 충분조건이다.}\\[2pt]
ㄷ. $x+y=4$는 $\overline{\mathrm{AP}}=\overline{\mathrm{BP}}$이기 위한 \nob{필요조건이다.}
\end{bogibox}
\begin{choices32}{ㄱ}{ㄷ}{ㄱ,ㄴ}{ㄴ,ㄷ}{ㄱ,ㄴ,ㄷ}\end{choices32}
\end{problem}
}
\end{pagepair}

% ══════════════════════════════════════════════════════════════════════════
% 페이지 2 (선택형 Q5~Q8) · 좌 {5,6} · 우 {7,8}
% ══════════════════════════════════════════════════════════════════════════
\begin{pagepair}
\pagecolumnpair{%
\begin{problem}{5}{s}
좌표평면 위의 도형 $F$는 방정식 $f(x,\,y)=0$이 나타내는 도형이고, 도형 $G$는 방정식 $f(y,\,x-a)=0$이 나타내는 도형이다. 도형 $F$를 도형 $G$로 옮기는 이동을 $T$라 하자. 상수 $a$가 다음 조건을 모두 만족시킨다.
\begin{conditions}
(가) 이동 $T$에 의하여 직선 $2x+y-1=0$이 옮겨진 직선은 원 $x^{2}+y^{2}=5$에 접한다.\\
(나) $a$는 자연수이다.
\end{conditions}
이동 $T$에 의하여 점 $(4,\,7)$이 옮겨지는 점을 $\mathrm{A}$라 할 때, 점 $\mathrm{A}$의 좌표는? \pts{4.9}
\begin{choices32}{$(1,\,4)$}{$(3,\,4)$}{$(7,\,8)$}{$(8,\,7)$}{$(11,\,4)$}\end{choices32}
\end{problem}

\vfill

\begin{problem}{6}{s}
전체집합 $U=\{1,\,2,\,3,\,\cdots,\,20\}$의 두 부분집합 $A$, $B$가 다음 조건을 모두 만족시킨다.
\begin{conditions}
(가) $A$와 $B$에 모두 속하는 $U$의 원소는 $3$개이고, $A$와 $B$ 중 어느 것에도 속하지 않는 $U$의 원소도 $3$개이다.\\
(나) $A$에 속하고 $B$에 속하지 않는 원소는 모두 짝수이며, $B$에 속하고 $A$에 속하지 않는 원소는 모두 $3$의 배수 또는 $5$의 배수이다.
\end{conditions}
$n(A)$가 $n(B)$의 배수일 때, $n(A)$의 값을 $M$, $A-B$의 모든 원소의 합의 최댓값을 $S$라 하자. $M+S$의 값은? \pts{5.0}
\begin{choices}
\choice{$70$}
\choice{$74$}
\choice{$82$}
\choice{$92$}
\choice{$105$}
\end{choices}
\end{problem}
}{%
\begin{problem}{7}{s}
좌표평면 위의 두 원
$$C_{1}:x^{2}+y^{2}=36,$$
$$C_{2}:x^{2}+y^{2}-2kx-2ky+2k^{2}-r^{2}=0$$
이 서로 다른 두 점 $\mathrm{A}$, $\mathrm{B}$에서 만난다. 두 양수 $k$, $r$가 다음 조건을 모두 만족시킨다.
\begin{conditions}
(가) 직선 $\mathrm{AB}$는 원 $C_{2}$의 넓이를 이등분한다.\\
(나) 선분 $\mathrm{AB}$의 길이는 $4$이다.
\end{conditions}
$k+r$의 값은? \pts{5.0}
\begin{choices}
\choice{$4$}
\choice{$5$}
\choice{$6$}
\choice{$7$}
\choice{$8$}
\end{choices}
\end{problem}

\vfill

\begin{problem}{8}{s}
두 집합 $A$, $B$가 $A\cup B=\{1,\,2,\,3,\,4,\,5\}$를 만족시킨다. $n(A-B)=1$ 또는 $n(B-A)=1$이 되도록 하는 순서쌍 $(A,\,B)$의 개수는? \pts{5.1}
\begin{choices}
\choice{$32$}
\choice{$70$}
\choice{$140$}
\choice{$160$}
\choice{$243$}
\end{choices}
\end{problem}
}
\end{pagepair}

