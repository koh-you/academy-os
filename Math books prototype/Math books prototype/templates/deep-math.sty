% ── \dmbracket v3.12 : 시각 요소 제거 · 공간만 유지 ────
\newcommand{\dmbracket}[1]{%
  \par\vspace{-7mm}\hfill
  \begin{tikzpicture}[baseline=0pt]
    \node[anchor=west, xshift=1mm, inner sep=1pt] at (10mm, 0) {%
      \phantom{\footnotesize\sffamily 정답과 풀이 #1쪽}};
  \end{tikzpicture}%
  \par\vspace{2mm}%
}

% ── \dmconcepthead v5.0 (double rule로 시각 강화) ───────────
% 개념 2·3·… 페이지 상단 · 위쪽 빈 텍스트 줄 + 골드+라벤더 이중 가로선
\newcommand{\dmconcepthead}{%
  \par\vspace{5mm}%
  \strut\par
  \noindent
  \begin{tikzpicture}
    \draw[dm-gold, line width=1.4pt] (0,0) -- (18mm,0);
    \draw[dm-rule, line width=0.4pt] (18mm,0) -- (\linewidth,0);
    \draw[dm-rule!60, line width=0.3pt] (0,-0.8mm) -- (\linewidth,-0.8mm);
  \end{tikzpicture}%
  \par\vspace{5mm}%
}

% ── \dmchapter{01}{제목} v5.0 (v4.0 배지 + 로고 유지 · 하단 이중 rule) ─
% v4.0 골든 유지 (지시 1·2)
% v5.0 추가: 배너 하단 골드+라벤더 이중선으로 시각 무게 증대
\newcommand{\dmchapter}[2]{%
  \renewcommand{\dmchapnum}{#1}%
  \renewcommand{\dmchapname}{#2}%
  \thispagestyle{dmchap}%
  \par\noindent
  \begin{tikzpicture}[baseline=(cn.base)]
    % 01 배지 · v4.0 골든 (14.4mm × 10.4mm · gradient + drop shadow)
    \node[
      rounded corners=1.5mm,
      inner sep=0pt,
      minimum width=14.4mm, minimum height=10.4mm,
      top color=dm-primary, bottom color=dm-primarydark,
      drop shadow={shadow xshift=0.6mm, shadow yshift=-0.6mm, fill=dm-shadow, opacity=0.7}
    ] (cn) {%
      {\sffamily\bfseries\Large\color{white}#1}};
    % 단원명 · 배지 우측
    \node[right=3mm of cn.east, anchor=west, inner sep=0pt] (cnm) {%
      {\sffamily\bfseries\Huge\color{dm-primary}#2}};
    % 로고 · 배너 오른쪽 끝 · 같은 세로
    \node[anchor=east, inner sep=0pt] at ([xshift=\linewidth-1mm]cn.west) {%
      \includegraphics[height=5mm]{logo}%
    };
  \end{tikzpicture}%
  \par\vspace{2mm}%
  % v5.0 : 이중 rule (골드 굵은선 + 라벤더 얇은선 이중)
  \noindent\begin{tikzpicture}
    \draw[dm-gold, line width=1.4pt] (0,0) -- (14.4mm,0);
    \draw[dm-rule, line width=0.4pt] (14.4mm,0) -- (\linewidth,0);
    \draw[dm-rule!60, line width=0.3pt] (0,-0.8mm) -- (\linewidth,-0.8mm);
  \end{tikzpicture}%
  \par\vspace{2mm}%
}

% ── dmconcept 환경 v5.5 (상하 여백 균형 · 세션 65) ────────
% 마스터 지시 (v5.2) : 박스가 둥근 형태(arc=1mm)인데 좌측 세로 bar는 직선 → 시각 불일치. 삭제
% 유지: 배경 dm-accent · 프레임 라벤더 · drop fuzzy shadow · 배지 shadow
% v5.4 (세션 58): default height 225mm → 214mm (dmchapter 병존 A4 정합)
% v5.5 → v5.6 (세션 65 후반 · valign=center 부작용 정정):
%   v5.5 valign=center: 배지 overlay와 콘텐츠 상단이 세로 겹침 (콘텐츠가 중앙으로 밀려 배지 y-line 침범)
%   v5.6 valign=top 복원: 배지 아래에서 콘텐츠 자연 시작 · top=7mm 유지 (마스터 지적 상단 축소)
%         bottom=9mm (하단 확장으로 콘텐츠 꽉 찬 개념의 붙음 완화)
%         콘텐츠 짧은 개념은 텍스트 (dmnote·dmexplain·dmexample) 보강으로 하단 여백 균형
\newenvironment{dmconcept}[3][214mm]{%
  \par\vspace{2mm}%
  \begin{tcolorbox}[
    enhanced,
    height=#1, valign=top,
    colback=dm-accent, colframe=dm-rule,
    boxrule=0.7pt, arc=1mm,
    left=7mm, right=7mm, top=7mm, bottom=9mm,
    drop fuzzy shadow=dm-shadow,
    overlay={%
      % 소단원 배지 · 골드 사각 (v4.0 유지)
      \node[fill=dm-gold, inner sep=0pt,
            minimum width=8mm, minimum height=8mm,
            anchor=center,
            drop shadow={shadow xshift=0.4mm, shadow yshift=-0.4mm, fill=dm-shadow, opacity=0.6}
            ] (badge) at ([xshift=8mm]frame.north west) {%
        {\sffamily\bfseries\normalsize\color{white}#2}};
      \node[fill=dm-primary, inner sep=0pt,
            minimum height=8mm,
            anchor=west,
            text width=\dimexpr\linewidth-25mm\relax, align=left,
            drop shadow={shadow xshift=0.4mm, shadow yshift=-0.4mm, fill=dm-shadow, opacity=0.6}
            ] at (badge.east) {%
        \hspace{4mm}{\sffamily\bfseries\normalsize\color{white}#3}};
      % (v5.1) 우상단 브랜드 삼각 mark 삭제
    }
  ]
  \ignorespaces
}{%
  \end{tcolorbox}\par\vspace{2mm}%
}

% ── 부속 라벨 3종 v5.1 (pill 라벨 유지 + 라벨 아래 subtle 짧은 실선) ────
% ── 부속 라벨 3종 v5.3 (골드 pill · 실선 테두리 추가) ─────
% v5.0 pill (goldlight bg + goldark text · 테두리 없음)
% v5.1 오해석 폐기 (라벨 아래 밑줄)
% v5.2 오해석 폐기 (콘텐츠 전체 tcolorbox)
% v5.3 (마스터 정확 지시): pill 자체 테두리를 실선으로 (draw=dm-goldark · 0.4pt)
%   → 예·참고 pill이 실선 테두리를 가진 골드 박스 (배경+텍스트+테두리 실선)
%   콘텐츠는 라벨 뒤 hangindent 방식 (v5.0 이전 유지)
\newcommand{\dmexlabel}{%
  \tikz[baseline=(exl.base)]\node[
    fill=dm-goldlight, draw=dm-goldark, line width=0.4pt,
    rounded corners=1mm,
    inner xsep=1.6mm, inner ysep=0.4mm, outer sep=0pt] (exl) {%
    {\sffamily\bfseries\footnotesize\color{dm-goldark}예}};%
}
\newenvironment{dmexample}{%
  \par\vspace{3mm}\noindent
  \hangindent=8mm\hangafter=1
  \makebox[7mm][l]{\dmexlabel}\ignorespaces
}{%
  \par\vspace{2mm}
}

\newcommand{\dmnotelabel}{%
  \tikz[baseline=(ntl.base)]\node[
    fill=dm-goldlight, draw=dm-goldark, line width=0.4pt,
    rounded corners=1mm,
    inner xsep=1.6mm, inner ysep=0.4mm, outer sep=0pt] (ntl) {%
    {\sffamily\bfseries\footnotesize\color{dm-goldark}참고}};%
}
\newenvironment{dmnote}{%
  \par\vspace{3mm}\noindent
  \hangindent=11mm\hangafter=1
  \makebox[10mm][l]{\dmnotelabel}\ignorespaces
}{%
  \par\vspace{2mm}
}

\newcommand{\dmexplainlabel}{%
  \tikz[baseline=(epl.base)]\node[
    fill=dm-goldlight, draw=dm-goldark, line width=0.4pt,
    rounded corners=1mm,
    inner xsep=1.6mm, inner ysep=0.4mm, outer sep=0pt] (epl) {%
    {\sffamily\bfseries\footnotesize\color{dm-goldark}설명}};%
}
\newenvironment{dmexplain}{%
  \par\vspace{3mm}\noindent
  \hangindent=11mm\hangafter=1
  \makebox[10mm][l]{\dmexplainlabel}\ignorespaces
}{%
  \par\vspace{2mm}
}

% ── \dmspecial 배지 : 교과과정 외 · 특강 표시 (2026-07-19 신설) ───
% 사용: \dmspecial 을 dmsub 뒤에 붙이거나 개념 서두에 인라인 배치
% 시각: dm-primary 배경 pill · 흰 텍스트 · rounded · subtle drop shadow
\newcommand{\dmspecial}{%
  \tikz[baseline=(sp.base)]\node[
    fill=dm-primary, draw=dm-primary, line width=0.3pt,
    rounded corners=1mm,
    inner xsep=2mm, inner ysep=0.6mm, outer sep=0pt] (sp) {%
    {\sffamily\bfseries\footnotesize\color{white}특강}};%
}

% ── \dmsub{N}{제목} v5.0 (그라디언트 배지 + drop shadow) ────
% v4.0: flat gold 원 (6.5mm)
% v5.0: top color goldlight → bottom color gold · drop shadow · 크기 유지
\newcommand{\dmsub}[2]{%
  \par\vspace{5mm}\noindent
  \begin{tikzpicture}[baseline=(sb.base)]
    \node[circle,
          top color=dm-gold, bottom color=dm-goldark,
          minimum size=6.5mm, inner sep=0pt,
          drop shadow={shadow xshift=0.3mm, shadow yshift=-0.3mm, fill=dm-shadow, opacity=0.6}
          ] (sb) {%
      {\sffamily\bfseries\small\color{white}#1}};
    \node[right=2mm of sb.east, anchor=west, inner sep=0pt] {%
      {\sffamily\bfseries\normalsize\color{dm-primary}#2}};
  \end{tikzpicture}%
  \par\vspace{2mm}%
}

% ── \dmex{N}{제목} v5.2 (좌측 골드 accent bar 삭제 · 둥근 배너 정합) ─
% 마스터 지시 (v5.2) : 배너가 둥근 형태(arc=2.5mm)인데 좌측 세로 bar 직선 → 시각 불일치. 삭제
% 유지: colback dm-primary · drop fuzzy shadow (입체감)
\newcommand{\dmex}[2]{%
  \par\vspace{7mm}\noindent
  \begin{tcolorbox}[
    enhanced,
    colback=dm-primary, colframe=dm-primary,
    boxrule=0pt, arc=2.5mm,
    left=6mm, right=6mm, top=2.5mm, bottom=2.5mm,
    width=\linewidth,
    drop fuzzy shadow=dm-shadow,
  ]
  {\sffamily\bfseries\large\color{white}예제\ #1\hspace{6mm}\color{dm-goldlight}\textperiodcentered\hspace{6mm}\color{white}#2}
  \end{tcolorbox}%
  \par\vspace{3mm}%
}

% ── dmproblem 환경 v5.1 (좌측 골드 세로 bar 삭제 · 둥근 형태 정합) ─
% 마스터 지시 2 : 박스가 둥근 형태(arc=3mm)인데 좌측 세로 bar는 직선 → 시각 불일치
% 유지: colback dm-accent · 라벤더 프레임 (arc=3mm) · drop fuzzy shadow
\newenvironment{dmproblem}{%
  \par\vspace{2mm}\noindent
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=dm-accent, colframe=dm-rule,
    boxrule=0.7pt, arc=3mm,
    left=7mm, right=6mm, top=4mm, bottom=4mm,
    drop fuzzy shadow=dm-shadow,
  ]
  \ignorespaces
}{%
  \end{tcolorbox}\par\vspace{4mm}%
}

% ── dmapproach·dmsolution 환경 v5.0 (라벨 drop shadow 강화) ────
% v4.0: rounded corners · flat fill
% v5.0: drop shadow 추가 · 시각 무게 증대
\newlength{\dmlabelw}\setlength{\dmlabelw}{11mm}
\newlength{\dmlabelh}\setlength{\dmlabelh}{5mm}

\newcommand{\dmapproachlabel}{%
  \tikz[baseline=(al.base)]\node[
    top color=dm-gold, bottom color=dm-goldark,
    rounded corners=1.5mm,
    minimum width=\dmlabelw, minimum height=\dmlabelh,
    inner sep=0pt,
    drop shadow={shadow xshift=0.3mm, shadow yshift=-0.3mm, fill=dm-shadow, opacity=0.6}
    ] (al) {%
    {\sffamily\bfseries\footnotesize\color{white}길잡이}};%
}

\newenvironment{dmapproach}{%
  \par\vspace{3mm}\noindent
  \hangindent=\dimexpr\dmlabelw+2mm\relax\hangafter=1
  \makebox[\dimexpr\dmlabelw+1mm\relax][l]{\dmapproachlabel}\ignorespaces
}{%
  \par\vspace{2mm}
}

\newcommand{\dmsollabel}{%
  \tikz[baseline=(sl.base)]\node[
    top color=dm-primary, bottom color=dm-primarydark,
    rounded corners=1.5mm,
    minimum width=\dmlabelw, minimum height=\dmlabelh,
    inner sep=0pt,
    drop shadow={shadow xshift=0.3mm, shadow yshift=-0.3mm, fill=dm-shadow, opacity=0.6}
    ] (sl) {%
    {\sffamily\bfseries\footnotesize\color{white}풀이}};%
}

% v5.6 (세션 63) · hangindent → list 기반 재설계
% 문제: \hangindent는 첫 문단만 유효 · \par·equation 뒤 텍스트가 좌측 여백까지 낙하
% 해결: list 환경으로 \leftmargin이 매크로 종료까지 지속 · 다중 문단·display math 모두 정합
\newenvironment{dmsolution}{%
  \par\vspace{3mm}%
  \begin{list}{}{%
    \setlength{\leftmargin}{\dimexpr\dmlabelw+2mm\relax}%
    \setlength{\rightmargin}{0pt}%
    \setlength{\labelwidth}{\dmlabelw}%
    \setlength{\labelsep}{2mm}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\topsep}{0pt}%
    \setlength{\parsep}{4pt plus 1pt}%
    \setlength{\itemsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \renewcommand{\makelabel}[1]{##1\hfil}%
  }%
  \item[\dmsollabel]\ignorespaces
}{%
  \end{list}\vspace{2mm}%
}

% ── \dmanswer{...} v5.1 (골드 pill/컬러 박스 삭제 · 텍스트만 · v3.1 유사) ─
% 마스터 지시 3 : 정답 표기는 담백해야 · pill/컬러 박스 제거
% 형식: 우측 정렬 · "답  xxx" · "답" 회색 · 값 dm-primary bold
\newcommand{\dmanswer}[1]{%
  \par\vspace{2mm}\hfill%
  {\sffamily\small\color{dm-gray}답}\hspace{3mm}%
  {\sffamily\color{dm-primary}\bfseries #1}%
  \par
}

% ── \dmchecktitle v5.0 (gradient + drop shadow + accent dots) ─
% v4.0: flat 골드 배너 (20mm × 7mm)
% v5.0:
%   - top color dm-gold → bottom color dm-goldark (gradient)
%   - drop shadow
%   - 우측 dm-primary dot 3개 accent (subtle · brand mark)
\newcommand{\dmchecktitle}{%
  \par\vspace{12mm}\noindent
  \begin{tikzpicture}[baseline=(ct.base)]
    \node[
      top color=dm-gold, bottom color=dm-goldark,
      inner sep=0pt,
      minimum width=20mm, minimum height=7mm,
      drop shadow={shadow xshift=0.4mm, shadow yshift=-0.4mm, fill=dm-shadow, opacity=0.6}
