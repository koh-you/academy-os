% ── 색 팔레트 v5.0 (기존 유지 + 그라디언트 보조색 3종) ─────
\definecolor{dm-primary}{HTML}{4A1A5C}    % 짙은 퍼플. 배너·강조
\definecolor{dm-secondary}{HTML}{8E44AD}  % 중간 퍼플. 서브
\definecolor{dm-light}{HTML}{EBDEF0}      % 옅은 퍼플. 프레임·배경
\definecolor{dm-accent}{HTML}{F5EEF8}     % 아주 옅은. 배경
\definecolor{dm-ink}{HTML}{1A1A2E}        % 짙은 남색-검정. 본문
\definecolor{dm-gold}{HTML}{B7791F}       % 골드. signature
\definecolor{dm-goldlight}{HTML}{F9E7C2}  % 옅은 골드. 배지 배경
\definecolor{dm-goldbg}{HTML}{FDF6E3}     % 아주 옅은 골드. answer pill 배경 (v5.0 신설)
\definecolor{dm-rule}{HTML}{D2B4DE}       % 옅은 라벤더. 프레임 선
\definecolor{dm-gray}{HTML}{6B6B6B}       % 회색
\definecolor{dm-graybg}{HTML}{F4F4F4}     % 회색 배경
\definecolor{dm-shadow}{HTML}{D4C5DA}     % 음영색 (옅은 라벤더 회색)
\definecolor{dm-primarydark}{HTML}{2E0F3A} % 짙은 퍼플 gradient bottom (v5.0 신설)
\definecolor{dm-goldark}{HTML}{8A5A16}    % 짙은 골드 gradient bottom (v5.0 신설)
\definecolor{dm-copper}{HTML}{B87333}     % 메탈릭 구리 (실전 배지 · 세션 54 신설)
\definecolor{dm-copperdark}{HTML}{7C4A20} % 짙은 카퍼 gradient bottom (세션 54 신설)

