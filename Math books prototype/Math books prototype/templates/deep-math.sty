% ── \dmkichul{출처} 학평·기출 출처 배지 (마더텅 스타일) ─────
% 사용: \dmpnum{N}{\dmkichul{2022학년도 11월 고1 학평 19번} 본문...}
% - 문항 번호 오른쪽 flushright 정렬
% - 작은 sans-serif · dm-primary 색 · 옅은 dm-primary 테두리 rounded box
% - dmpnum 첫 줄에 배지 후 개행 → 본문
\newcommand{\dmkichul}[1]{%
  \null\hfill\tikz[baseline=(x.base)]{
    \node[draw=dm-primary!40, rounded corners=1.2pt, inner sep=2pt, inner ysep=1.2pt,
          font=\footnotesize\sffamily, text=dm-primary!85, line width=0.4pt] (x) {#1};
  }\par\noindent%
}

% ══════════════════════════════════════════════════════════════
% ── v5.2 후보 H · 조건 박스 (\dmoptionbox) ─────────────────
% ══════════════════════════════════════════════════════════════
% 사용: \begin{dmoptionbox} ... \end{dmoptionbox}
% 대상: 조건 목록 (가) X / (나) Y / (다) Z  또는  보기 목록 ㄱ. X · ㄴ. Y · ㄷ. Z
% 시각 스펙:
%   - 배경 dm-accent (기존 dmproblem·dmconcept과 톤 통일)
%   - 왼쪽 accent bar 3pt · dm-gold (박스 좌측 굵은 세로선)
%   - 내부 여백 : 상하 2mm · 좌우 3mm
%   - 모서리 rounded 1pt (arc=1mm)
%   - 프레임 없음 (colframe=dm-accent · 배경과 같은 색으로 프레임 시각 제거)
% 매크로 사용 예:
%   \begin{dmoptionbox}
%   (가) $n(X) = 6$
%
%   (나) $A - X = B - X$
%
%   (다) $(X - A) \cap (X - B) \ne \varnothing$
%   \end{dmoptionbox}
%
% \dmoptioninline{...} : 인라인 형태 (한 줄에 3개 나열 등 · minipage 대체)
%   본문 안에서 자연 문단 흐름 유지하며 얇은 박스로 감싸는 경우 사용
\newenvironment{dmoptionbox}{%
  \par\vspace{2mm}%
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=dm-accent, colframe=dm-accent,
    boxrule=0pt, arc=1mm,
    left=6mm, right=3mm, top=2mm, bottom=2mm,
    borderline west={3pt}{0pt}{dm-gold},
  ]
  \ignorespaces
}{%
  \end{tcolorbox}\par\vspace{2mm}%
}

% 인라인 사용 : \dmoptioninline{$\quad$ㄱ. ... \quad ㄴ. ... \quad ㄷ. ...}
\newcommand{\dmoptioninline}[1]{%
  \par\smallskip
  \begin{tcolorbox}[
    enhanced,
    colback=dm-accent, colframe=dm-accent,
    boxrule=0pt, arc=1mm,
    left=6mm, right=3mm, top=1.5mm, bottom=1.5mm,
    borderline west={3pt}{0pt}{dm-gold},
  ]
  #1
  \end{tcolorbox}%
  \par\smallskip
}

