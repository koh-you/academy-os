% ── 유형 헤더 + 풀폭 TIP ──
% 시그니처: \begin{type}{유형번호}{유형이름}[TIP 텍스트(선택)]
% multicols/페이지 분리는 \begin{pagepair}...\end{pagepair} 환경이 담당.
\NewDocumentEnvironment{type}{m m +O{}}{%
  \par\addvspace{14pt}%
  \needspace{6\baselineskip}%
  \noindent
  \begin{minipage}{\linewidth}
  \tikz[baseline=0pt]\fill[vB-accent] (0,-2pt) rectangle (3pt,18pt);\hspace{6pt}%
  {\sffamily\small\color{vB-accent}\textbf{유형 #1}}\hspace{8pt}%
  {\sffamily\bfseries\large\color{vB-deep} #2}
  \end{minipage}
  \par\vspace{2pt}%
  {\color{vB-rule}\rule{\linewidth}{0.3pt}}\par\smallskip
  \ifblank{#3}{}{%
    \par\vspace{2pt}%
    \begin{tipbox}
      \sffamily\bfseries\color{vB-accent}TIP\quad\normalfont\color{vB-ink}#3
    \end{tipbox}%
    \par\vspace{-2pt}%
  }%
}{%
}

% ── 페이지 페어 — 2문제씩 묶어 한 페이지에 (좌1+우1) ──
% v1.2 (2026-06-28): 페이지 번호 노드 제거 (fancyfoot이 이미 출력). 좌·우 분할선만 유지.
% 분할선 + 2단 multicols + 자동 \clearpage.
% pagepair: 4 minipage 2×2 grid (multicols 대신 수동 grid)
% 본문 양식: \begin{pagepair}\probA{...}\probB{...}\probC{...}\probD{...}\end{pagepair}
\newenvironment{pagepair}{%
  \par\noindent%
  \small
}{%
  \clearpage
}
% 4문 grid 배치 매크로 — 좌상, 우상, 좌하, 우하
\newcommand{\probgridfour}[4]{%
  \noindent
  \begin{minipage}[t][\probboxheight][t]{0.46\linewidth}#1\end{minipage}\hfill
  \begin{minipage}[t][\probboxheight][t]{0.46\linewidth}#2\end{minipage}
  \par\vspace{4mm}
  \noindent
  \begin{minipage}[t][\probboxheight][t]{0.46\linewidth}#3\end{minipage}\hfill
  \begin{minipage}[t][\probboxheight][t]{0.46\linewidth}#4\end{minipage}
  \par
}

% ── \probpair — 자동 크기 통일 매크로 (2026-07-11 신설) ──
% 사용: \probpair{좌 문항 코드}{우 문항 코드}
% 원리: savebox로 두 문항 크기 자동 측정 → max+\probvpadding으로 좌우 minipage 크기 통일
%       → 좌우 하단 baseline 정렬, 페이지 빈 공간 최소화
% 각 minipage 안 문항 뒤 자연스러운 여백 확보 (남는 공간 표시)
\newsavebox{\probleftbox}
\newsavebox{\probrightbox}
\newlength{\probunifiedheight}
\newlength{\probvpadding}
\setlength{\probvpadding}{20mm}  % 문항 아래 최소 여백 목표값
\newcommand{\probpair}[2]{%
  % Step 1: 두 문항 실제 크기 측정 (raggedright로 stretch·중간 break 방지)
  \sbox{\probleftbox}{\begin{minipage}{0.46\linewidth}\raggedright #1\end{minipage}}%
  \sbox{\probrightbox}{\begin{minipage}{0.46\linewidth}\raggedright #2\end{minipage}}%
  % Step 2: max(좌,우) 크기 계산
  \setlength{\probunifiedheight}{\dimexpr\ht\probleftbox+\dp\probleftbox\relax}%
  \ifdim\dimexpr\ht\probrightbox+\dp\probrightbox\relax>\probunifiedheight
    \setlength{\probunifiedheight}{\dimexpr\ht\probrightbox+\dp\probrightbox\relax}%
  \fi
  % Step 3: 여백 padding 추가
  \addtolength{\probunifiedheight}{\probvpadding}%
  % Step 4: 좌우 통일 크기로 배치 — 좁은 컬럼(0.46) raggedright 적용
  %   근본 이유: 좁은 컬럼 + 인라인 수식 많은 한글 문장에서 justified 정렬은
  %   ① 어절 사이 공백을 극단 stretch → 부자연 간격
  %   ② 한글 낱말(순서쌍·서술하시오 등)을 중간에서 끊음
  %   raggedright는 justify를 폐기하여 두 문제 동시 해결.
  \noindent
  \begin{minipage}[t][\probunifiedheight][t]{0.46\linewidth}\raggedright #1\end{minipage}%
  \hfill
  \begin{minipage}[t][\probunifiedheight][t]{0.46\linewidth}\raggedright #2\end{minipage}%
  \par
}

% ── \pagecolumnpair — 옵션 A 세로 컬럼 우선 균등 분배 매크로 (2026-07-26 세션 93 후반 신설) ──
% 배경: probpair(좌우 max 균등) + pagepair(상하 3-vfill)는 좌측 컬럼 안 상하 문항 균등 보장 불가.
%       마스터 확정 (2026-07-26): "좌측과 우측이 문제풀이공간 배분을 할 때 독립적으로 움직여야 함"
% 원리: 좌측 컬럼·우측 컬럼 각각 minipage(자연 크기 아닌 페이지 남은 공간 stretch)
%       각 컬럼 안 \vfill 이 문항 사이 남은 공간을 균등 분배
%       두 컬럼 완전 독립 · 좌측 컬럼의 문항 크기가 우측에 영향 없음
% 사용법:
%   \begin{pagepair}
%   \pagecolumnpair{%
%     \begin{problem}{1}{s}...\end{problem}     % Q1 좌상
%     \vfill
%     \begin{problem}{2}{s}...\end{problem}     % Q2 좌하
%   }{%
%     \begin{problem}{3}{s}...\end{problem}     % Q3 우상
%     \vfill
%     \begin{problem}{4}{s}...\end{problem}     % Q4 우하
%   }
%   \end{pagepair}
%
% 3문 페이지 (Q17·Q18·Q19): 우측 컬럼에 Q19 하나만 · 하단 빈
% 단독 페이지 (Q20): 좌측 컬럼에 Q20 하나만 · 나머지 빈
\newlength{\pagecolumnheight}
\newlength{\pagecolumnfullheight}   % p2~ 통상 페이지 남은 공간
\newlength{\pagecolumnfirstheight}  % p1 examheader 이후 남은 공간
\setlength{\pagecolumnfullheight}{175mm}
\setlength{\pagecolumnfirstheight}{60mm}   % v1.9 : 80→60mm · p1 fit 시도
\newcommand{\pagecolumnpair}[2]{%
  % v2.2 (2026-07-26 후반) : 상단 시작 + 균등 분배 (마스터 지적 "5번 페이지 한참 아래서 시작" 계기)
  %   결함 v2.1 : 앞 자동 \vspace*{\fill} 삽입 → 첫 문항이 컬럼 중앙으로 밀림
  %   정정 v2.2 : 앞 vfill 삭제 · 뒤 vfill만 자동 삽입
  %              → 첫 문항 컬럼 최상단 자연 시작 · 사용자 명시 vfill + 자동 뒤 vfill = 균등 분배
  %              (Q5 최상단 · Q5·Q6 사이·Q6 아래 균등)
  % 🔴🔴 2026-08-02 세션 109 — `-2\baselineskip` 은 **안전 여유다. 빼지 마라.**
  %    빼 봤더니 컬럼이 남은 자리보다 커져 재현-1회가 7쪽 → **10쪽**,
  %    딥매쓰 A·B형이 각각 **12쪽**으로 늘었다. 즉시 되돌렸다.
  %
  %    🔴 다만 마스터 지적은 살아 있다 — 이 2줄이 **마지막 문항 아래에만 남아**
  %    실측으로 늘 약 14mm 더 넓다 (2쪽 62.1→76.0 · 3쪽 63.2→77.2).
  %    고칠 곳은 높이가 아니라 **마지막 여백을 그만큼 줄이는 것**이다 — 아래 \pagecolumntail 참조.
  %    잴 때는 `python scripts/풀이공간-실측.py <문제.pdf>` 를 쓴다. 눈대중 금지.
  \setlength{\pagecolumnheight}{\dimexpr\vsize-\pagetotal-2\baselineskip\relax}%
  % 🔴 2026-08-02 세션 109 — 마지막 채움에서 `2\baselineskip` 을 뺀다.
  %    까닭: 컬럼 높이가 아래에서 `2\baselineskip` 만큼 짧다(안전 여유).
  %    그 자리는 어느 문항에도 안 나뉘고 **마지막 문항 아래에만 남아** 실측 약 14mm 더 넓었다.
  %    마지막 채움을 그만큼 줄이면 [안 여백 + 아래 여유] 가 앞 문항의 여백과 같아진다.
  %    셈: 채움 하나를 f 라 하면 마지막은 f−2bl 이고, 보이는 것은 (f−2bl)+2bl = f 다.
  %    🔴 확인은 `python scripts/풀이공간-실측.py <문제.pdf>` — 눈대중 금지.
  \noindent
  \begin{minipage}[t][\pagecolumnheight][s]{0.46\linewidth}%
    \raggedright #1\vspace*{\fill}\vspace*{-2\baselineskip}%
  \end{minipage}%
  \hfill
  \begin{minipage}[t][\pagecolumnheight][s]{0.46\linewidth}%
    \raggedright #2\vspace*{\fill}\vspace*{-2\baselineskip}%
  \end{minipage}%
  \par
}

% ── \probpairstretch — 서답형 split 문항 균등 배분 매크로 (2026-07-14 세션 36 v2 신설) ──
% \probpair의 [t] top-align은 excess가 마지막 sub 뒤에 붙어 (3)이 다른 sub보다 커 보임.
% [s] stretch-align + \vfill로 excess를 컬럼 최하단에 위치, sub 답안 공간 명확히 X mm 경계.
% 사용: body 마지막에 반드시 \vfill 삽입 (좌·우 모두).
\newcommand{\probpairstretch}[2]{%
  \sbox{\probleftbox}{\begin{minipage}{0.46\linewidth}\raggedright #1\end{minipage}}%
  \sbox{\probrightbox}{\begin{minipage}{0.46\linewidth}\raggedright #2\end{minipage}}%
  \setlength{\probunifiedheight}{\dimexpr\ht\probleftbox+\dp\probleftbox\relax}%
  \ifdim\dimexpr\ht\probrightbox+\dp\probrightbox\relax>\probunifiedheight
    \setlength{\probunifiedheight}{\dimexpr\ht\probrightbox+\dp\probrightbox\relax}%
  \fi
  % No padding — column excess flows to \vfill at bottom
  \noindent
  \begin{minipage}[t][\probunifiedheight][s]{0.46\linewidth}\raggedright #1\end{minipage}%
  \hfill
  \begin{minipage}[t][\probunifiedheight][s]{0.46\linewidth}\raggedright #2\end{minipage}%
  \par
}

% ── \probpairbalance — 서답형 split 문항 여유공간 균등 분배 매크로 (2026-07-14 세션 36 신설) ──
% 사용:
%   \probpairbalance{좌 body}{좌 sub 개수}{우 body}{우 sub 개수}{총 sub 개수}
% 원리:
%   1. 좌·우 body (sub 답안 공간 제외한 순수 문항 콘텐츠) 자연 높이 측정
%   2. 좌우 컬럼을 위해 필요한 통일 높이 계산: unified = max(좌_body + N_L·X, 우_body + N_R·X)
%      + 여유공간을 총 sub 개수 (N_total)로 균등 분할 → 각 sub 답안 공간 X 자동 계산
%   3. 각 sub 답안 공간에 정확히 X mm 삽입 (elastic 아님)
%   4. 좌우 컬럼 하단 padding 0 → 두 컬럼 시각적으로 완전 일치
% 마스터 지시 (2026-07-14): "분할공간 내 문제자체 공간 제외한 여유공간을 각 문항에 균등분배".
%
% 실제 사용: 저자가 답안 vspace를 명시적으로 계산해서 \vspace*{X mm} 배치.
%           본 매크로는 padding 0으로 만든 wrapper.
\newcommand{\probpairtight}[2]{%
  \begingroup
  \setlength{\probvpadding}{0mm}%
  \probpair{#1}{#2}%
  \endgroup
}

% ── \probpairequal — 우측 컬럼 elastic (2)(3) 균등 분배 (2026-07-14 세션 36 v4 신설) ──
% 마스터 명시 (2026-07-14): "좌측분할공간은 그대로 놓고 우측 분할 공간만 두문제에 대해 균등 분배"
% 좌: [t][H][t] 그대로 · 우: [t][H][s] stretch-align → `plus 1fill` elastic 확장
% 우측 sub vspaces에 `plus 1fill` 붙이면 우측 컬럼 안 균등 분배
\newcommand{\probpairequal}[2]{%
  \sbox{\probleftbox}{\begin{minipage}{0.46\linewidth}\raggedright #1\end{minipage}}%
  \sbox{\probrightbox}{\begin{minipage}{0.46\linewidth}\raggedright #2\end{minipage}}%
  \setlength{\probunifiedheight}{\dimexpr\ht\probleftbox+\dp\probleftbox\relax}%
  \ifdim\dimexpr\ht\probrightbox+\dp\probrightbox\relax>\probunifiedheight
    \setlength{\probunifiedheight}{\dimexpr\ht\probrightbox+\dp\probrightbox\relax}%
  \fi
  \noindent
  \begin{minipage}[t][\probunifiedheight][t]{0.46\linewidth}\raggedright #1\end{minipage}%
  \hfill
  \begin{minipage}[t][\probunifiedheight][s]{0.46\linewidth}\raggedright #2\end{minipage}%
  \par
}

% ── \probpairfillpage — 페이지 하단까지 우 컬럼 확장 (2026-07-14 세션 36 v5 신설) ──
% 마스터 명시 (2026-07-14): "페이지 하단 여백이라는게 존재 하면 안됨"
% 좌·우 minipage 모두 고정 height = 페이지 usable · 우 [s] stretch로 elastic 분배
% 좌 minipage은 top-align이라 콘텐츠 위 배치, 아래 blank는 시각적으로 divider까지 자연 연속
\newlength{\probpairfullheight}
\setlength{\probpairfullheight}{215mm}   % 페이지 usable 기본값 (B5 essay page) — 페이지 하단 여백 제거
\newcommand{\probpairfillpage}[2]{%
  \noindent
  \begin{minipage}[t][\probpairfullheight][t]{0.46\linewidth}%
    \raggedright\emergencystretch=6em\tolerance=3000\hbadness=3000
    \XeTeXlinebreakskip=0pt plus 0pt minus 0pt
    \XeTeXlinebreakpenalty=0
    #1%
  \end{minipage}%
  \hfill
  \begin{minipage}[t][\probpairfullheight][s]{0.46\linewidth}%
    \raggedright\emergencystretch=6em\tolerance=3000\hbadness=3000
    \XeTeXlinebreakskip=0pt plus 0pt minus 0pt
    \XeTeXlinebreakpenalty=0
    #2%
  \end{minipage}%
  \par
}

% ── \probpairfulll — 서답형 essay 문항용 (2026-07-14 세션 36 v3 신설) ──
% 컬럼 하단 alignment로 (3) sub answer가 col-bottom과 일치 → 명확한 시각 bound.
% [t][H][b] = 좌우 minipage 크기 통일 · 콘텐츠 하단 정렬 · 남는 공간은 각 컬럼 top에 blank.
\newcommand{\probpairfull}[2]{%
  \sbox{\probleftbox}{\begin{minipage}{0.46\linewidth}\raggedright #1\end{minipage}}%
  \sbox{\probrightbox}{\begin{minipage}{0.46\linewidth}\raggedright #2\end{minipage}}%
  \setlength{\probunifiedheight}{\dimexpr\ht\probleftbox+\dp\probleftbox\relax}%
  \ifdim\dimexpr\ht\probrightbox+\dp\probrightbox\relax>\probunifiedheight
    \setlength{\probunifiedheight}{\dimexpr\ht\probrightbox+\dp\probrightbox\relax}%
  \fi
  \noindent
  \begin{minipage}[t][\probunifiedheight][t]{0.46\linewidth}\raggedright #1\end{minipage}%
  \hfill
  \begin{minipage}[t][\probunifiedheight][b]{0.46\linewidth}\raggedright #2\end{minipage}%
  \par
}

% \nob (mid-word break 방지)는 아래 line 636에 정의됨.

% ── TIP — 옅은 블루 배경 + 좌측 블루 바 ──
\newtcolorbox{tipbox}{enhanced,breakable,
  colback=vB-light,colframe=vB-accent,
  boxrule=0pt,leftrule=2.5pt,rightrule=0pt,toprule=0pt,bottomrule=0pt,
  arc=0pt,outer arc=0pt,left=10pt,right=8pt,top=4pt,bottom=3pt,fontupper=\small}
\newcommand{\tip}[1]{\par\smallskip\begin{tipbox}
  \sffamily\bfseries\color{vB-accent}TIP\quad\normalfont\color{vB-ink}#1
\end{tipbox}\par\smallskip}

% ── 제시 조건 박스 — (가)(나) 같은 문제 조건 묶음 ──
% v1.3 (2026-06-28, 마스터 명시): 테두리 블랙 (배경 흰색 + 검은 실선).
% 통합 박스 디자인 (2026-07-11 통일): 각진 사각형·얇은 프레임·일관된 padding.
% 조건 박스(condbox)·본문 내 [정의]·[보기]·[법칙] 박스 모두 같은 스타일 적용.
\newtcolorbox{condbox}{enhanced,breakable,
  colback=white,colframe=black,
  boxrule=0.4pt,arc=0pt,outer arc=0pt,
  left=4pt,right=4pt,top=3pt,bottom=3pt,
  fontupper=\small}
\newenvironment{conditions}{%
  \par\smallskip
  \begin{condbox}
  \setlength{\parskip}{2pt}%
}{%
  \end{condbox}
  \par\smallskip
}

% ── 문제 — 수능 표준 풍 (큰 번호 inline + 본문 자연 흐름) ──
% minipage로 감싸 한 문항이 한 컬럼 안에서 하나의 덩어리로 묶이게 함.
% 둘째 인자 #2는 호환성을 위해 받기만 하고 사용하지 않음.
% problem 환경: 고정 높이 minipage (페이지 안 4문 등간격 시작)
\newlength{\probboxheight}
\setlength{\probboxheight}{100mm}
\newcounter{probnum}
% ── problem 환경 (2026-07-11 v2): 자연 크기 minipage
%   이전 [t][\probboxheight][t] 고정 크기 → [t] 자연 크기로 변경.
%   외부 pagepair minipage 또는 \probpair가 크기 결정. 문항 자체는 자기 크기.
%   \probboxheight 매개변수는 유지 (외부 minipage 크기 지정용, 하위 호환).
\newenvironment{problem}[2]{%
  \par%
  \setcounter{probnum}{#1}%
  \noindent
  \begin{minipage}[t]{\linewidth}%
  \raggedright%  좁은 컬럼 justify 폐기 (한글 어절 stretch·낱말 중간 break 방지)
  \setlength{\parskip}{4pt plus 1pt}%
  {\sffamily\bfseries\large\color{vB-ink}#1.}\hspace{4pt}\ignorespaces
}{%
  \end{minipage}\par%
}

% ── 보기 ──
\newcounter{choicecnt}
% ── 한 줄 균등 배치 보기 환경 ──
% \hbox to \linewidth로 정확히 minipage 폭 채움.
% ① 왼쪽 끝, ⑤ 오른쪽 끝, ③ 자동 중앙, 사이 4 hfill 균등 분할.
\newenvironment{choices}{\par\medskip\setcounter{choicecnt}{0}%
  \noindent\hbox to \linewidth\bgroup\small\ignorespaces}{%
  \egroup\par\medskip}
\newcommand{\circmark}{\ifcase\value{choicecnt}\or①\or②\or③\or④\or⑤\fi}
\newcommand{\choice}[1]{\stepcounter{choicecnt}%
  \ifnum\value{choicecnt}=1\relax\else\hfill\fi
  \mbox{\circmark\ #1}}
\newif\ifshowanswers\showanswersfalse
\newcommand{\answer}[1]{\ifshowanswers{\small\color{vB-dim}[정답: #1]}\fi}

% ── 긴 보기 환경: 5개 보기를 2-2-1 행으로 분배 ──
% 사용: \begin{choicesii}{①본문}{②본문}{③본문}{④본문}{⑤본문}\end{choicesii}
\newenvironment{choicesii}[5]{%
  \par\medskip\noindent
  \begin{tabular}{@{}p{0.49\linewidth}@{\hskip 0.02\linewidth}p{0.49\linewidth}@{}}
    \mbox{\small ①\ #1} & \mbox{\small ②\ #2} \\[2pt]
    \mbox{\small ③\ #3} & \mbox{\small ④\ #4} \\[2pt]
    \mbox{\small ⑤\ #5} & \\
  \end{tabular}%
}{\par\medskip}

% ── 세로 나열 보기 환경 (긴 부등식·긴 수식 보기용) ──
% 사용: \begin{choicesv}{①본문}{②본문}{③본문}{④본문}{⑤본문}\end{choicesv}
% 각 보기가 한 줄씩 아래로 왼쪽 정렬 (긴 부등식 자연 배치).
\newenvironment{choicesv}[5]{%
  \par\medskip\noindent
  \begin{tabular}{@{}l@{}}
    \mbox{\small ①\ #1} \\[2pt]
    \mbox{\small ②\ #2} \\[2pt]
    \mbox{\small ③\ #3} \\[2pt]
    \mbox{\small ④\ #4} \\[2pt]
    \mbox{\small ⑤\ #5} \\
  \end{tabular}%
}{\par\medskip}

% ── 3-2 두 줄 보기 환경 (짧은 좌표·분수 5개 보기용) ──
% 사용: \begin{choices32}{①본문}{②본문}{③본문}{④본문}{⑤본문}\end{choices32}
% 3개(위) + 2개(아래) 두 줄. tabular*로 minipage 전체 폭 균등 배치.
% 두 줄 사이 12pt 간격.
\newenvironment{choices32}[5]{%
  \par\medskip\noindent
  \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}lll@{}}
    \mbox{\small ①\ #1} & \mbox{\small ②\ #2} & \mbox{\small ③\ #3} \\[12pt]
    \mbox{\small ④\ #4} & \mbox{\small ⑤\ #5} & \\
  \end{tabular*}%
}{\par\medskip}

% ── 출처 인용 매크로 (공개 기출용) ──
\newcommand{\examcite}[1]{\quad{\footnotesize\sffamily\color{vB-dim}#1}}

% ── [출제의도] 라벨 (답지 풀이 도입부 표시, 학평 표준 스타일 v2.6 §22.1) ──
% 사용: \examintent{이차방정식의 근과 계수의 관계를 활용하여 문제 해결하기}
% → 출력: [출제의도] 이차방정식의 근과 계수의 관계를 활용하여 문제 해결하기
% 단일 인자: 단원명 + 동사 결합 문자열. 학평 동사 4단계 (계산/이해/문제 해결/추론) 의무.
\newcommand{\examintent}[1]{%
  \par\noindent
  {\footnotesize\sffamily\bfseries\color{vB-deep}[출제의도]}\,%
