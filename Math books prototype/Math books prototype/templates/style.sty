% ── 인라인 수식 줄바꿈 방지 ──
% 이항 연산자(+, -, ×, /)와 관계 연산자(=, <, >, ≤, ≥)에서 LaTeX이 줄바꿈하지 않도록
% 페널티를 최대로 설정. 하나의 인라인 수식이 중간에서 끊기지 않음.
\binoppenalty=10000
\relpenalty=10000

% ── 좁은 컬럼 어절 간격 stretch 완화 ──
% probpair 0.46\linewidth (~76mm) 좁은 컬럼 + 인라인 수식 많은 한글 문장에서
% LaTeX 기본 justified 정렬이 어절 사이 공백을 극단적으로 stretch → 부자연.
% \emergencystretch 확대로 badness 감내폭 늘려 stretch 폭 축소.
% \tolerance = 2000 (기본 200)으로 라인 재배열 여유 부여.
\emergencystretch=4em
\tolerance=2000
\hbadness=2000

% ═══ 답지 전용 프리셋 매크로 (v3.3, 2026-07-12 세션 34 신설) ═══
% 사용: \answersheetsetup — 답지 preamble 또는 \begin{document} 직후 한 번 호출
%
% 세션 34 진단: 답지 multicols 좁은 컬럼에서
%   ① 인라인 \tfrac 사용 시 매우 작게 렌더 → 시각 불균일
%   ② multicols의 justified 정렬로 어절 stretch·낱말 mid-word break
%   ③ 세션 32 4-Layer fix가 style.sty problem env에만 적용 · 답지 multicols에는 미적용
%
% 대응: 답지 전용 defaults 한 번에 적용
%   1. \tfrac → \dfrac 재정의 (인라인이라도 큰 분수)
%   2. 문서 전역 \raggedright (multicols·컬럼 좁아도 자연 정렬)
%   3. \emergencystretch 답지용 확대 (6em)
% \solprefixwd: soltitle "13. hspace" prefix 폭 저장용 전용 dimen (\@tempdima 충돌 회피)
\newdimen\solprefixwd

% 시험지 답지용 soltitle: 파일 상위 레벨에서 정의 (\newcommand 중첩 회피)
\newcommand{\soltitleexam}[3]{%
  \par\leftskip=0pt%
  \stepcounter{solcount}%
  \ifsoltitlefirst
    \par\addvspace{12pt}%
    \soltitlefirstfalse
  \else
    \par\addvspace{20pt}%
  \fi
  \needspace{2\baselineskip}%
  % ── 소문항 (1)(2)(3) 정답 세로 정렬 (v3.7.3, 2026-07-13 세션 35 확립) ──
  % 요구: (1)은 문항번호 옆 시작 · (2)(3)은 다음 줄, (1)과 동일 열 정렬
  % 사용: \soltitle{13}{(1) 답 \\ (2) 답 \\ (3) 답}{6}
  %
  % 시행착오 이력:
  %   • \parbox/minipage: 첫 줄(=(1))이 강제 새 줄로 밀림 → 실패
  %   • \hangindent+\hangafter=1: multicols + answersheetsetup 환경에서
  %     \raggedright·\parskip·\@normalcr 상호작용으로 무효화 → 실패
  %   • \parshape: 동일한 이유로 무효화 → 실패
  %   • (성공) \\ 재정의: 로컬 begingroup 안에서 \\를 \hfil\break+\hspace*로
  %     재정의해 각 새 줄 시작에 solprefixwd 폭의 hspace 자동 주입
  \settowidth{\solprefixwd}{\sffamily\bfseries\large #1.\hspace{10pt}}%
  \begingroup
  \def\\{\hfil\break\hspace*{\solprefixwd}\ignorespaces}%
  \noindent{\sffamily\bfseries\large\color{vB-ink} #1.}\hspace{10pt}%
  {\bfseries\color{black}#2}%
  \par
  \endgroup
  \nobreak\vspace{-4pt}\noindent%
  \tikz{\draw[vB-deep, line width=1.2pt, line cap=butt] (0,0) -- (\linewidth,0);}%
  \par\vspace{14pt}%
}

% 시험지 답지용 tfrac: 인라인에서도 dfrac 크기
% (\let 대신 \newcommand로 정의 · 사용 시 \tfrac 유지)
\newcommand{\tfracdisplay}[2]{\dfrac{#1}{#2}}

% \answersheetsetup — 답지 전용 defaults 일괄 적용
% 사용: \begin{document} 직후 한 번 호출
\newcommand{\answersheetsetup}{%
  % ── raggedright + emergencystretch (좁은 컬럼 어절 stretch·mid-word break 방지) ──
  \raggedright%
  \emergencystretch=6em%
  \hfuzz=2pt% soltitle leftskip·hangindent 미세 오차 1.2pt 무시
  % ── 분수·soltitle alias (v3.6) ──
  \let\tfrac\tfracdisplay%           % \tfrac을 dfrac 크기로 alias
  \let\frac\dfrac%                   % \frac도 강제 displaystyle (인라인/디스플레이 크기 통일)
  \let\soltitle\soltitleexam%        % \soltitle을 시험지 답지용으로 alias
  % ── Tier 1·4·5 답지 가독성 defaults 편입 (v3.7, 2026-07-12) ──
  % 세션 19 (2026-07-08) 확립 · 세션 34 시스템화 · 원인: 로컬 반복 → 시스템 매크로 이관
  \linespread{1.18}\selectfont%      % Tier 1 라인 여유 (분수 tall inline math 수용)
  \setlength{\parskip}{10pt plus 3pt minus 2pt}%  % Tier 1 확대 (6pt → 10pt · dfrac 상단 여유 · 페이지 확대 최소화)
  % \lineskiplimit·\lineskip 조정: dfrac 라인이 인접 문장에 딱 붙지 않도록
  \lineskiplimit=4pt
  \lineskip=6pt
  \thinmuskip=3mu plus 1mu%           % Tier 1 인라인 수식 얇은 공백 확대
  \medmuskip=4.5mu plus 2mu minus 4mu%
  \thickmuskip=5.5mu plus 5mu%
  \setlength{\mathindent}{0pt}%       % Tier 4 fleqn 좌측 정렬 (documentclass에서 fleqn 옵션 필요)
  \setlength{\abovedisplayskip}{12pt}%     % Tier 4 디스플레이 위 여유
  \setlength{\belowdisplayskip}{12pt}%     % Tier 4 디스플레이 아래 여유
  \setlength{\abovedisplayshortskip}{10pt}%
  \setlength{\belowdisplayshortskip}{10pt}%
  \setlength{\columnsep}{14mm}%       % Tier 5 컬럼 간격 확대 (multicols)
}

