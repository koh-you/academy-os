% v1.3 (2026-07-07 · T1-3 가독성 개선): 통찰 라벨 폰트 확대 + 좌측 세로 바 추가
% 통찰 박스 위 여백 조정 (22pt → 14pt). 풀이가 페이지에 들어가도록.
\newcommand{\solnote}[1]{%
  \par\leftskip=0pt% reset from prior \step
  \ifsolnoteoutput
    \par\addvspace{14pt}\noindent
    \begin{tcolorbox}[enhanced, breakable, colback=vB-light, colframe=vB-light,
      boxrule=0pt, arc=3pt,
      leftrule=3pt, colframe=vB-accent,% 좌측 세로 강조 바 3pt
      left=12pt, right=10pt, top=7pt, bottom=7pt,
      fontupper=\sffamily\footnotesize\color{vB-ink}]
      {\sffamily\bfseries\small\color{vB-deep}통찰}\quad #1
    \end{tcolorbox}%
    \par\addvspace{12pt}%
  \fi
}

% ─── 보기 박스 상단 라벨 걸치기 (2026-07-11 세션 33 신설) ───
% 와부고 기출 분석 프로젝트 CSS `.bogi` + `.bogi-title` 차용 (position:absolute + translateY(-50%)).
% `〈보기〉` 라벨이 박스 상단 선 중앙 왼쪽에 걸치는 스타일.
% 사용:
%   \begin{bogibox}
%   ㄱ. $\{\varnothing\}\in A$ \qquad ㄴ. $\{\varnothing\}\subset A$
%   \end{bogibox}
\newtcolorbox{bogibox}{
  enhanced, breakable,
  colback=white, colframe=black,
  boxrule=0.4pt, arc=0pt,
  left=4pt, right=4pt, top=6pt, bottom=4pt,
  fontupper=\small,
  overlay={%
    \node[fill=white, inner sep=2pt, anchor=west, font=\sffamily\bfseries\small]
      at ([xshift=8pt, yshift=0pt]frame.north west) {〈보기〉};
  }
}

% ─── Critical Point 매크로 (2026-07-11 세션 33 신설) ───
% 와부고 기출 분석 프로젝트 차용. ★ 4·5 문항 답지에서 학생 함정 3선을 명시.
% 사용: \criticalpoint{① 실수 케이스 놓침 ② 조건 (다) 누락 ③ 부등호 방향 오류}
% 시각: solnote와 유사 (leftrule 3pt 강조 바) 하지만 오렌지·빨강 계열로 경고 신호.
\definecolor{vB-warn}{HTML}{9A3412}       % 짙은 갈오렌지 (라벨·강조 바 · v3.7.5 페이지 대비 강화)
\definecolor{vB-warn-light}{HTML}{FED7AA} % 옅은 피치 배경 (흰 페이지와 뚜렷한 대비, 라벨과도 5:1 대비 · v3.7.5)
% Critical Point 내부 함정 라벨 (v1.1, 2026-07-11 신규):
% \textbf 금지 정책 대신 오렌지 sans-serif bold로 학생 주의 유도.
% 사용: \criticalpoint{① \cplabel{라벨}: 설명 \quad ② \cplabel{...}: ... \quad ③ ...}
\newcommand{\cplabel}[1]{{\sffamily\bfseries\color{vB-warn}#1}}
\newcommand{\criticalpoint}[1]{%
  \par\leftskip=0pt%
  \par\addvspace{14pt}\noindent
  \begin{tcolorbox}[enhanced, breakable, colback=vB-warn-light, colframe=vB-warn-light,
    boxrule=0pt, arc=0pt,
    leftrule=3pt, colframe=vB-warn,%
    left=12pt, right=10pt, top=7pt, bottom=7pt,
    fontupper=\sffamily\footnotesize\color{vB-ink}]
    % v1.2 (2026-07-13 세션 35): 헤더 별도 줄 · 본문은 아래에 · 항목 간 \\ 로 줄바꿈 권장
    {\sffamily\bfseries\small\color{vB-warn}\raisebox{-0.1ex}{$\bigtriangleup$}\ Critical Point}%
    \par\smallskip
    #1
  \end{tcolorbox}%
  \par\addvspace{12pt}%
}

% ─── T1-1 소분할 라벨 매크로 (2026-07-07 가독성 개선 v1.0) ───
% 서답형 (1)(2)(3) 소분할 라벨을 파랑 굵게 + 자동 여백으로 시각화.
% 사용: \subitem{1} 위 공식을 적용하면 ~
% 이전: (1)\quad 위 공식을 적용하면 ~ (텍스트만)
\newcommand{\solpart}[1]{%
  \par\addvspace{6pt}\noindent
  {\sffamily\bfseries\color{vB-accent}(#1)}\hspace{3mm}\ignorespaces%
}

% ─── T1-2 케이스 라벨 매크로 ───
% 내부 케이스 (i)(ii)(iii) or 텍스트 라벨 [분석] 등을 컬러 강조.
% 사용: \subcase{i} $2$의 지수: ~
%       \subcasetext{분석} $P = 2^A$의 원소는 ~
\newcommand{\subcase}[1]{%
  \par\addvspace{4pt}\noindent
  {\sffamily\bfseries\color{vB-accent}(#1)}\hspace{2mm}\ignorespaces%
}
\newcommand{\subcasetext}[1]{%
  \par\addvspace{4pt}\noindent
  {\sffamily\bfseries\color{vB-accent}[#1]}\hspace{2mm}\ignorespaces%
}

% ── 문항 번호 옆 출처 표기 (작게, 회청색, 이탤릭) ──
% 사용: \textbf{[4번]}\probsource{2026 6월 고2 4번}\quad\pointbadge{3}
% 문항 번호 바로 옆에 붙여 작은 회청색 텍스트로 출처를 표기.
\newcommand{\probsource}[1]{\,{\footnotesize\sffamily\color{vB-dim}\textit{#1}}}

% ═══════════════════════════════════════════════════════
% 수택고 기말 — 시험지/답지 전용 매크로 (행렬 베이스 위에 추가)
% ═══════════════════════════════════════════════════════

% ── 답지 전용 톤 ──
\definecolor{vB-answer}{HTML}{FFF8DC}
\definecolor{vB-answer-rule}{HTML}{D4A017}

% ── 시험지 상단 헤더 (수능 표준 풍 — 좌·우 박스 + 가운데 큰 제목) ──
% 사용: \examheader{메인 제목}{부제}
\newcommand{\examheader}[2]{%
  \thispagestyle{empty}%
  \par\noindent
  \begin{tikzpicture}[remember picture]
    \node[draw=vB-deep, fill=white, line width=0.8pt, rounded corners=4pt,
          font=\sffamily\bfseries\color{vB-deep},
          inner xsep=10pt, inner ysep=4pt, anchor=south west] (Lbox) at (0,0) {\,기말대비\,};
    \node[font=\sffamily\Huge\bfseries\color{vB-ink}, anchor=base] at (\linewidth/2, 4pt) {\examround};
    \node[draw=vB-deep, fill=white, line width=0.8pt, rounded corners=4pt,
          font=\sffamily\bfseries\color{vB-deep},
          inner xsep=10pt, inner ysep=4pt, anchor=south east] (Rbox) at (\linewidth,0) {\,\examvol\,};
  \end{tikzpicture}%
  \par\vspace{6pt}
  \noindent{\color{vB-deep}\rule{\linewidth}{0.8pt}}\par
  \vspace{6pt}
  \noindent
  {\sffamily\small\color{vB-dim} #1}\par\vspace{1pt}
  {\sffamily\scriptsize\color{vB-dim} #2}\par\vspace{6pt}
  {\sffamily\footnotesize\color{vB-ink}
    학년·반·번호: \rule{42mm}{0.3pt}\hfill 이름: \rule{42mm}{0.3pt}}%
  \par\addvspace{10pt}
  \thispagestyle{examfooter}%
}

% ── 답지 상단 헤더 박스 (수능 표준 풍) ──
% 2026-07-07 마스터 명시: 큰 타이틀 한 줄만. 작은 부제·소부제 제거.
% 사용: \answerheader{2학기 중간 예상 1회 정답 및 해설}
% 좌상단 vol.n 박스는 유지 (별도 소형 stamp). 큰 tcolorbox 안은 오직 #1 타이틀.
\newcommand{\answerheader}[1]{%
  \thispagestyle{examfooter}%
  \par\noindent
  \begin{tikzpicture}[baseline=0pt]
    \node[draw=vB-deep, fill=white, line width=0.8pt, rounded corners=4pt,
          font=\sffamily\bfseries\color{vB-deep},
          inner xsep=10pt, inner ysep=4pt, anchor=south west] (Lbox) at (0,0) {\,\examvol\,};
  \end{tikzpicture}%
  \par\vspace{6pt}
  \begin{tcolorbox}[enhanced, colback=white, colframe=vB-answer-rule,
    boxrule=1.1pt, arc=10pt, left=18pt, right=18pt, top=13pt, bottom=13pt,
    halign=center]
    {\sffamily\LARGE\bfseries\color{vB-deep} #1}
  \end{tcolorbox}\par\addvspace{10pt}
}

% ── 빠른 정답표 그리드 (수능 표준 풍) ──
% 사용:
%   \begin{quickgrid}
%   \quick{1}{⑤ $...$} & \quick{2}{④ $...$} & \quick{3}{⑤ $6$} & \quick{4}{① $...$} & \quick{5}{④ $8$} \\
%   \quick{6}{...} & ...
%   \end{quickgrid}
% 5칸 tabular* + 둥근 박스.
%
% ── 박스 높이 = arraystretch × 행수. quickgrid 박스 높이를 CM1 골든 (5행 × 1.35 = 6.75) 기준으로
% 일정하게 유지하기 위해 \quickgridstretch 변수를 도입:
%   • 5행 (23문 시험지 기준):        \renewcommand{\quickgridstretch}{1.35}  (기본)
%   • 4행 (16~20문):                \renewcommand{\quickgridstretch}{1.70}  (= 1.35 × 5/4)
%   • 3행 (12~15문 중간고사 스타일): \renewcommand{\quickgridstretch}{2.25}  (= 1.35 × 5/3)
% preamble이나 \begin{quickgrid} 직전에 override. 세로 분할선 yshift (-125.6mm) 그대로 유지 가능.
% Why: 박스 크기를 일정하게 하면 답지 페이지 1의 답지헤더+quickgrid+examsection 스택 높이가
%      과목·회차 무관하게 동일 → yshift 하드코딩 값이 모든 답지에 유효 (재조정 불요).
\newcommand{\quickgridstretch}{1.35}
\newcommand{\quick}[2]{\textbf{\sffamily\color{vB-ink} #1.}\,\,{\sffamily\color{vB-ink} #2}}
\newenvironment{quickgrid}[1][빠른 정답표]{%
  \par\noindent
  \begin{tcolorbox}[enhanced, colback=white, colframe=vB-answer-rule,
    boxrule=0.8pt, arc=6pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
    title={■\,\,#1}, fonttitle=\sffamily\bfseries,
    coltitle=white, colbacktitle=vB-answer-rule,
    attach boxed title to top center={yshift=-3pt},
    boxed title style={colback=vB-answer-rule, sharp corners=downhill, boxrule=0pt,
      left=10pt, right=10pt, top=2pt, bottom=2pt}]
    \renewcommand{\arraystretch}{\quickgridstretch}\sffamily\small
    \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}lllll}
}{%
    \end{tabular*}\par
  \end{tcolorbox}\par\addvspace{25pt}% v2 (2026-07-07): 10pt → 25pt (박스-풀이 간격 +5mm 확보)
}

% ── 풀이 간 큰 간격 플래그 (true=다음 soltitle 컴팩트, false=2cm) ──
\newif\ifsoltitlefirst\soltitlefirsttrue

% ── 시험 출처 라벨 (슬림 — 좌측 굵은 바 + 작은 글씨) ──
% 사용: \examsection{2026 6월 고2 전국연합학력평가}
\newcommand{\examsection}[1]{%
  \par\addvspace{12pt}\needspace{4\baselineskip}%
  \noindent\textcolor{vB-deep}{\rule[-3pt]{3pt}{14pt}}\,\,%
  {\sffamily\bfseries\color{vB-deep}#1}%
  \par\vspace{2pt}%
  \noindent\textcolor{vB-rule}{\rule{\linewidth}{0.3pt}}%
  \par\addvspace{4pt}%
  \soltitlefirsttrue% examsection 직후 첫 soltitle은 컴팩트
}

