"""GPS 위성-수신기 정밀 삽화 template · Phase 2 신설
세션 36 골든 유래: 와부고 CM2 2회 #16

# --- CONFIG ---
sat_positions = [(-2.8, 2.0), (0.5, 4.3), (3.2, 3.0)]   # 위성 3개 위치 (각각 다른 거리)
sat_labels = ['위성 1', '위성 2', '위성 3']
receiver_x = 0.0    # 지상 수신기 x 좌표
fig_width = 9
fig_height = 6.5
# ---

의무 검증 (배포 전):
  node scripts/figure-completeness-check.mjs <name>.py
  node scripts/figure-label-overlap-check.mjs <name>.py
"""
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle, Polygon, Circle, Arc, FancyBboxPatch, Ellipse
import numpy as np

plt.rcParams['font.family'] = 'Malgun Gothic'
plt.rcParams['axes.unicode_minus'] = False

# ── CONFIG (수정 지점) ──
sat_positions = [(-2.8, 2.0), (0.5, 4.3), (3.2, 3.0)]
sat_labels = ['위성 1', '위성 2', '위성 3']
receiver_x = 0.0
fig_width = 9
fig_height = 6.5

# ── 색상 (baked-in) ──
sat_body = '#B85C2A'; sat_body_dark = '#7A3D1A'
sat_panel = '#3B6EB5'; sat_panel_light = '#6698D6'
sat_dish = '#DDD8C8'
ground_color = '#7A6E5C'; ground_dark = '#5A4E3C'
sky_top = '#E8F0F8'; sky_bottom = '#F5F5F0'
receiver = '#2A3B5A'; receiver_light = '#4A6086'
signal_color = '#D9552E'; label_color = '#2A2A2A'

fig, ax = plt.subplots(figsize=(fig_width, fig_height), dpi=150)
ax.set_aspect('equal')
ax.set_xlim(-5.5, 5.5)
ax.set_ylim(-3.5, 5.5)

# 하늘 그라디언트
n_gradient = 200
for i in range(n_gradient):
    y_bottom = -3.5 + i * 9.0 / n_gradient
    t = i / n_gradient
    r = int((1 - t) * int(sky_bottom[1:3], 16) + t * int(sky_top[1:3], 16))
    g = int((1 - t) * int(sky_bottom[3:5], 16) + t * int(sky_top[3:5], 16))
    b = int((1 - t) * int(sky_bottom[5:7], 16) + t * int(sky_top[5:7], 16))
    color = f'#{r:02X}{g:02X}{b:02X}'
    ax.add_patch(Rectangle((-5.5, y_bottom), 11.0, 9.0/n_gradient, facecolor=color, edgecolor='none', zorder=0))

# 지상 (곡면)
ground_x = np.linspace(-5.5, 5.5, 200)
ground_curve_top = -1.4 + 0.15 * np.cos(ground_x * 0.5)
verts_ground = list(zip(ground_x, ground_curve_top))
verts_ground.append((5.5, -3.5)); verts_ground.append((-5.5, -3.5))
ax.add_patch(Polygon(verts_ground, facecolor=ground_color, edgecolor='none', zorder=1))
ax.plot(ground_x, ground_curve_top, color=ground_dark, linewidth=1.2, zorder=2)

np.random.seed(42)
for _ in range(80):
    x = np.random.uniform(-5.4, 5.4)
    y_top = -1.4 + 0.15 * np.cos(x * 0.5)
    y_bot = y_top - np.random.uniform(0.03, 0.10)
    ax.plot([x, x], [y_top, y_bot], color=ground_dark, linewidth=0.4, alpha=0.5, zorder=2)

ax.text(-4.5, -2.6, '지상', color='white', fontsize=11, fontweight='bold', zorder=3)

# 지상 수신기
receiver_ground_y = -1.35 + 0.15 * np.cos(receiver_x * 0.5)
pole_w = 0.15; pole_h = 0.7
ax.add_patch(Rectangle((receiver_x - pole_w/2, receiver_ground_y), pole_w, pole_h,
                        facecolor=receiver, edgecolor=receiver_light, linewidth=0.6, zorder=5))
dish_center_y = receiver_ground_y + pole_h + 0.15
ax.add_patch(Ellipse((receiver_x, dish_center_y), 0.75, 0.45,
                      facecolor=sat_dish, edgecolor=receiver, linewidth=0.9, zorder=6))
ax.add_patch(Ellipse((receiver_x, dish_center_y - 0.02), 0.55, 0.32,
                      facecolor='#B5B0A5', edgecolor='none', zorder=7))
ax.add_patch(Circle((receiver_x, dish_center_y), 0.05, facecolor='#333', zorder=8))
ax.plot([receiver_x, receiver_x], [dish_center_y, dish_center_y + 0.35],
        color=receiver_light, linewidth=0.8, zorder=8)
ax.add_patch(Circle((receiver_x, dish_center_y + 0.35), 0.04, facecolor=receiver, zorder=8))
ax.text(receiver_x + 0.6, receiver_ground_y + 0.15, '수신기 $\\mathrm{P}$',
        color=receiver, fontsize=10, fontweight='bold', zorder=9)

# 위성 그리기
def draw_satellite(ax, x, y, label):
    body_w = 0.32; body_h = 0.28
    ax.add_patch(FancyBboxPatch((x - body_w/2, y - body_h/2), body_w, body_h,
                                 boxstyle='round,pad=0.02,rounding_size=0.03',
                                 facecolor=sat_body, edgecolor=sat_body_dark, linewidth=0.7, zorder=10))
    ax.plot([x - body_w/2 + 0.03, x + body_w/2 - 0.03], [y + body_h/2 - 0.04, y + body_h/2 - 0.04],
            color='#E5A87A', linewidth=0.6, alpha=0.8, zorder=11)
    panel_w = 0.55; panel_h = 0.20
    ax.add_patch(Rectangle((x - body_w/2 - panel_w - 0.03, y - panel_h/2), panel_w, panel_h,
                            facecolor=sat_panel, edgecolor=sat_panel_light, linewidth=0.5, zorder=10))
    ax.add_patch(Rectangle((x + body_w/2 + 0.03, y - panel_h/2), panel_w, panel_h,
                            facecolor=sat_panel, edgecolor=sat_panel_light, linewidth=0.5, zorder=10))
    for i in range(1, 4):
        gx1 = x - body_w/2 - panel_w - 0.03 + i * panel_w / 4
        gx2 = x + body_w/2 + 0.03 + i * panel_w / 4
        ax.plot([gx1, gx1], [y - panel_h/2 + 0.02, y + panel_h/2 - 0.02],
                color=sat_panel_light, linewidth=0.4, alpha=0.7, zorder=11)
        ax.plot([gx2, gx2], [y - panel_h/2 + 0.02, y + panel_h/2 - 0.02],
                color=sat_panel_light, linewidth=0.4, alpha=0.7, zorder=11)
    ax.plot([x, x], [y + body_h/2, y + body_h/2 + 0.15], color=sat_body_dark, linewidth=0.9, zorder=10)
    ax.add_patch(Circle((x, y + body_h/2 + 0.18), 0.04, facecolor=sat_body_dark, zorder=11))
    ax.text(x, y + body_h/2 + 0.35, label, color=label_color, fontsize=9, fontweight='bold',
            ha='center', va='bottom', zorder=12)

for (sx, sy), lb in zip(sat_positions, sat_labels):
    draw_satellite(ax, sx, sy, lb)

# 신호선
receiver_top = (receiver_x, dish_center_y + 0.4)
for sat_x, sat_y in sat_positions:
    ax.plot([sat_x, receiver_top[0]], [sat_y - 0.15, receiver_top[1]],
            color=signal_color, linewidth=0.9, linestyle=(0, (4, 3)), alpha=0.75, zorder=4)

# 파형 pulse
def draw_wave_pulse(ax, center, direction_angle_deg, color=signal_color):
    for i, r in enumerate([0.30, 0.42, 0.54]):
        arc = Arc(center, r*2, r*2, angle=direction_angle_deg, theta1=-45, theta2=45,
                   color=color, linewidth=0.7, alpha=0.6 - i*0.1, zorder=5)
        ax.add_patch(arc)

for sat_x, sat_y in sat_positions:
    direction_x = receiver_top[0] - sat_x
    direction_y = receiver_top[1] - sat_y
    angle = np.degrees(np.arctan2(direction_y, direction_x))
    draw_wave_pulse(ax, (sat_x, sat_y - 0.15), angle)

ax.text(-1.4, 0.5, '신호', color=signal_color, fontsize=9, fontweight='bold', rotation=-55, zorder=6)

ax.set_xticks([]); ax.set_yticks([])
for spine in ax.spines.values(): spine.set_visible(False)

plt.tight_layout(pad=0.3)
plt.savefig('satellite.pdf', bbox_inches='tight', pad_inches=0.05)
