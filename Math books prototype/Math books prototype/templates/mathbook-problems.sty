% ============================================================
%  난이도 점 (5단계 시스템, bank와 1:1 매핑)
% ============================================================
%  \dota ●○○○○ = 1단 (하)    공식 1개 직접 대입
%  \dotb ●●○○○ = 2단 (중하)  공식 + 간단 변형
%  \dotc ●●●○○ = 3단 (중)    개념 2개 결합, 조건 해석 1회
%  \dotd ●●●●○ = 4단 (중상)  다단계, 3+ 개념 결합
%  \dote ●●●●● = 5단 (상)    추론·역추적·경우 분류

\newcommand{\dota}{\,{\small\color{mbdarkgray}\textbullet}{\small\color{mbline}\textbullet}{\small\color{mbline}\textbullet}{\small\color{mbline}\textbullet}{\small\color{mbline}\textbullet}}
\newcommand{\dotb}{\,{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbline}\textbullet}{\small\color{mbline}\textbullet}{\small\color{mbline}\textbullet}}
\newcommand{\dotc}{\,{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbline}\textbullet}{\small\color{mbline}\textbullet}}
\newcommand{\dotd}{\,{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbline}\textbullet}}
\newcommand{\dote}{\,{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}{\small\color{mbdarkgray}\textbullet}}

