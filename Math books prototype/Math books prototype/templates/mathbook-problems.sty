% ============================================================
%  유형 헤더
% ============================================================
\newcounter{typenum}[subsection]
\newcommand{\typename}[2]{%
  \stepcounter{typenum}%
  \vspace{0pt}
  \noindent
  \tikz[baseline=(T.base)]{
    \node[fill=step1color, text=white, rounded corners=3pt,
          inner xsep=7pt, inner ysep=3pt,
          font=\small\bfseries\sffamily] (T) {유형 \ifnum\value{typenum}<10 0\fi\the\value{typenum}};
  }\;%
  {\bfseries\sffamily #1}%
  \par
  \ifx\relax#2\relax\else
    \vspace{2pt}
    {\small\sffamily\color{mbgray}#2}
    \par
  \fi
  \vspace{2pt}
}

% ============================================================
%  유형 헤더 + TIP 묶음 (고정 높이 컨테이너)
% ============================================================
%  좌/우 컬럼의 유형 영역을 동일 높이로 만들어 첫 문제 시작 위치를 정렬한다.
%  typetip의 본문 길이에 따라 1줄/2줄로 변동되어도 본 박스가 같은 높이를 갖는다.
\newcommand{\typeheader}[2]{%
  \parbox[t][2cm][t]{\linewidth}{%
    \typename{#1}{}%
    \typetip{#2}%
  }\par
}

% ============================================================
%  문제 셀 고정 높이 (좌/우 컬럼 N번째 문제 정렬용)
% ============================================================
%  컬럼 내 모든 문제 셀이 동일한 고정 높이를 가져 좌/우 N번째 문제가
%  같은 y좌표에서 시작하도록 한다.
%  셀 크기는 최대 문제 본문 길이보다 살짝 큰 정도로 잡고, 남은 공간은
%  셀 사이에 .tex에서 명시적으로 넣는 `\vfill`이 분배한다.
%  → 문제 간 간격은 (셀 잔여 여백 + vfill 분배분), 마지막 문제 아래
%    여백은 (셀 잔여 여백)만큼만 남음 ⇒ inter-prob > bottom.
%
%  - \probcellab : STEP 1/2 페이지용. 본문 최대 ~2.6cm + 여유 → 3.2cm.
%                  남은 vfill 2개 × 2.2cm 분배.
%  - \probcellc  : STEP 3 페이지용. 본문 최대 ~4cm(#43 규칙 정의 포함) → 4cm.
%                  남은 vfill 2개 × 2cm 분배.
\newlength{\probcellab}
\setlength{\probcellab}{3.2cm}
\newlength{\probcellc}
\setlength{\probcellc}{4cm}

\newenvironment{cellab}[1][\probcellab]{%
  \par\noindent
  \begin{minipage}[t][#1][t]{\linewidth}%
}{%
  \end{minipage}\par
}
\newenvironment{cellc}[1][\probcellc]{%
  \par\noindent
  \begin{minipage}[t][#1][t]{\linewidth}%
}{%
  \end{minipage}\par
}

% ============================================================
%  문제 번호 (3자리 연번)
% ============================================================
\newcounter{probnum}
\newcommand{\problabel}{%
  \stepcounter{probnum}%
  \ifnum\value{probnum}<100
    \ifnum\value{probnum}<10 00\else 0\fi
  \fi\the\value{probnum}%
}

% ============================================================
%  문제 환경 (깔끔한 스타일 — 박스 없음)
% ============================================================
\newenvironment{prob}[1][]{%
  \par\vspace{4pt}
  \noindent
  {\fontsize{13}{13}\selectfont\bfseries\sffamily\color{mbdarkgray}\problabel}%
  \hspace{4pt}{\small #1}%
  \par\vspace{4pt}
  \noindent
  \linespread{1.2}\selectfont
}{%
  \par\vspace{4pt}
}

% ============================================================
%  대표 문제 (번호 + 대표 라벨)
% ============================================================
\newenvironment{repprob}[1][]{%
  \par\vspace{4pt}
  \noindent
  \tikz[baseline=(N.base)]{
    \node[fill=step1color, text=white, rounded corners=2pt,
          inner xsep=5pt, inner ysep=2pt,
          font=\fontsize{13}{13}\selectfont\bfseries\sffamily] (N) {\problabel};
  }\;%
  \tikz[baseline=(L.base)]{
    \node[draw=step1color, text=step1color, rounded corners=2pt,
          inner xsep=4pt, inner ysep=1pt,
          font=\tiny\bfseries\sffamily, line width=0.6pt] (L) {대표 문제};
  }\;%
  {\small #1}%
  \par\vspace{3pt}
  \noindent
  \linespread{1.2}\selectfont
}{%
  \par\vspace{4pt}
}

% ============================================================
%  줄바꿈 방지 매크로
%  \nob{...}      — 임의 텍스트/수식 한 줄로 묶음 (mbox wrapper)
%  \cond{...}     — "(단, ...)" 한 줄로 묶음
%  사용 예시:
%    \nob{$x$축}, \nob{$x$좌표}, \nob{($a>2$)}, \nob{$\mathrm{O}$는 원점}
%    \cond{$x\neq 0$, $y>1$} → "(단, x≠0, y>1)"
% ============================================================
\newcommand{\nob}[1]{\mbox{#1}}
\newcommand{\cond}[1]{\mbox{(단, #1)}}

% ============================================================
%  보기 번호 (유니코드 원문자 — 본문 폰트 크기에 맞춤)
% ============================================================
\newcommand{\circnum}[1]{%
  {\small\ifcase#1\or ①\or ②\or ③\or ④\or ⑤\fi}%
}

% ============================================================
%  객관식 보기 — 1줄 (짧은 보기용, 5개 가로 균등)
% ============================================================
\newlength{\choicewidth}
\newcommand{\choices}[5]{%
  \par\vspace{10pt}
  \setlength{\choicewidth}{0.2\linewidth}%
  \noindent
  \makebox[\choicewidth][l]{\circnum{1}\,#1}%
  \makebox[\choicewidth][l]{\circnum{2}\,#2}%
  \makebox[\choicewidth][l]{\circnum{3}\,#3}%
  \makebox[\choicewidth][l]{\circnum{4}\,#4}%
  \makebox[\choicewidth][l]{\circnum{5}\,#5}%
  \par\vspace{4pt}
}

% ============================================================
%  객관식 보기 — 2줄 (긴 보기용, 3+2 배치)
% ============================================================
\newlength{\choicewideunit}
\newcommand{\choicesii}[5]{%
  \par\vspace{10pt}
  \setlength{\choicewideunit}{0.36\linewidth}%
  \noindent
  \makebox[\choicewideunit][l]{\circnum{1}\,#1}%
  \makebox[\choicewideunit][l]{\circnum{2}\,#2}%
  \circnum{3}\,#3%
  \\[3pt]
  \noindent
  \makebox[\choicewideunit][l]{\circnum{4}\,#4}%
  \circnum{5}\,#5%
  \par\vspace{4pt}
}

% ============================================================
%  객관식 보기 — 3줄 (매우 긴 보기용, 2+2+1 배치)
% ============================================================
\newcommand{\choicesiii}[5]{%
  \par\vspace{10pt}
  \setlength{\choicewideunit}{0.5\linewidth}%
  \noindent
  \makebox[\choicewideunit][l]{\circnum{1}\,#1}%
  \circnum{2}\,#2%
  \\[3pt]
  \noindent
  \makebox[\choicewideunit][l]{\circnum{3}\,#3}%
  \circnum{4}\,#4%
  \\[3pt]
  \noindent
  \circnum{5}\,#5%
  \par\vspace{4pt}
}

% ============================================================
%  객관식 보기 — 5줄 (조건식 등 절 단위 길이, 세로 배치)
% ============================================================
\newcommand{\choicesv}[5]{%
  \par\vspace{10pt}
  \noindent
  \circnum{1}\,#1\\[2pt]
  \circnum{2}\,#2\\[2pt]
  \circnum{3}\,#3\\[2pt]
  \circnum{4}\,#4\\[2pt]
  \circnum{5}\,#5
  \par\vspace{4pt}
}

% ============================================================
%  자동 보기 — 가장 긴 보기 폭으로 배치 선택
%  기준 (linewidth = \probcolwidth ≈ 6cm 기준):
%    < 0.18\linewidth (≈1.1cm) → \choices       (한 줄, 5개)
%    < 0.32\linewidth (≈1.9cm) → \choicesii     (3+2)
%    < 0.48\linewidth (≈2.9cm) → \choicesiii    (2+2+1)
%    그 이상                   → \choicesv      (5세로)
% ============================================================
\newlength{\maxchwidth}
\newlength{\tmpchwidth}
\newcommand{\@measurech}[1]{%
  \settowidth{\tmpchwidth}{\circnum{1}\,#1}%
  \ifdim\tmpchwidth>\maxchwidth\setlength{\maxchwidth}{\tmpchwidth}\fi
}
\newcommand{\autochoices}[5]{%
  \setlength{\maxchwidth}{0pt}%
  \@measurech{#1}\@measurech{#2}\@measurech{#3}\@measurech{#4}\@measurech{#5}%
  \ifdim\maxchwidth<0.18\linewidth\relax
    \choices{#1}{#2}{#3}{#4}{#5}%
  \else\ifdim\maxchwidth<0.32\linewidth\relax
    \choicesii{#1}{#2}{#3}{#4}{#5}%
  \else\ifdim\maxchwidth<0.48\linewidth\relax
    \choicesiii{#1}{#2}{#3}{#4}{#5}%
  \else
    \choicesv{#1}{#2}{#3}{#4}{#5}%
  \fi\fi\fi
}

