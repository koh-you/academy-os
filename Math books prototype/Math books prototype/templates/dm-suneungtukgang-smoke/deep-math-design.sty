% =============================================================================
% M9 · \dmlevelbanner{N} — Level 배너 (수능특강 D1 재해석)
%   근거: 수능특강 p.14 (Level 1) · p.16 (Level 2) · p.33 (Level 3 은색)
%   요소: 좌측 알약 (Level) + 겹치는 원형 숫자 배지 + 우측 부제 + U자 hook
%   색 재해석:
%     - 수능특강 짙은 녹색 #6B8E4E → DeeP Math dm-primary (짙은 퍼플)
%     - Level 3만 dm-copper (기존 dmrealtype 카퍼 = 심화 시각언어) 재사용 · 차별화
%   폭: \linewidth · 높이 약 13mm (알약) + 18mm (원형 배지 돌출)
%   난이도: D2 (쉬움)
%   사용: \dmlevelbanner{1} · \dmlevelbanner{2} · \dmlevelbanner{3}
%
%   v1.1 조정 (마스터 지적 [1]):
%     - 알약 폭 32mm → 36mm (원형 배지 여유 확보)
%     - Level 텍스트 hspace 4mm → 6mm (좌측 정렬 · `l` 가림 해소)
%     - 원형 배지 xshift -2mm → -1mm (알약과 겹침 축소)
% =============================================================================
\newcommand{\dmlevelbanner}[1]{%
  \par\vspace{7mm}\noindent
  \begin{tikzpicture}[baseline=(lvl.base)]
    % 좌측 옅은 라벤더 알약 (Level 텍스트 · 배경)
    % v1.1: 폭 36mm · Level 텍스트는 왼쪽 정렬 (원형 배지 우측 진입 공간 확보)
    % text 위치: hspace 없이 배지 우측 여백 (10mm) 확보 · 알약 우측 끝은 배지 중심
    \node[
      fill=dm-light, text=dm-primary,
      rounded corners=2mm,
      inner xsep=6mm, inner ysep=3mm,
      minimum width=36mm, minimum height=11mm,
      font=\sffamily\Large, anchor=west
    ] (lvl) at (0,0) {%
      \makebox[24mm][l]{Level}%
    };
    % 겹치는 원형 배지 (Level 3만 카퍼)
    % v1.1 재조정: 배지 중심을 알약 우측 끝 근처 (xshift=+3mm) 로 이동
    % → "Level" 텍스트 (왼쪽 24mm 폭) 와 절대 겹침 없음
    \ifnum#1=3
      \node[circle,
            top color=dm-copper, bottom color=dm-copperdark,
            minimum size=15mm, inner sep=0pt, anchor=center,
            drop shadow={shadow xshift=0.4mm, shadow yshift=-0.4mm, fill=dm-shadow, opacity=0.6}
      ] (lvnum) at ([xshift=3mm]lvl.east) {%
        {\sffamily\bfseries\LARGE\color{white}#1}};
    \else
      \node[circle,
            top color=dm-primary, bottom color=dm-primarydark,
            minimum size=15mm, inner sep=0pt, anchor=center,
            drop shadow={shadow xshift=0.4mm, shadow yshift=-0.4mm, fill=dm-shadow, opacity=0.6}
      ] (lvnum) at ([xshift=3mm]lvl.east) {%
        {\sffamily\bfseries\LARGE\color{white}#1}};
    \fi
    % 우측 부제 (Level 1~3 지정 텍스트)
    \node[right=5mm of lvnum.east, anchor=west, inner sep=0pt] (sub) {%
      {\sffamily\bfseries\Large\color{dm-primary}%
        \ifcase#1\or 기초 연습\or 표준 연습\or 심화 연습\fi}};
    % 우측 얇은 라인 + U자 hook (부제 우측 → \linewidth 끝)
    % 알약 폭 36mm + 배지 xshift 3mm + 배지 반지름 7.5mm + 5mm + subtitle est. 24mm
    \draw[dm-rule, line width=0.5pt]
      ([xshift=6mm]sub.east) -- ([xshift=\linewidth-6mm-40mm-46mm]sub.east|-lvnum.east) coordinate (hookL);
    \draw[dm-rule, line width=0.5pt]
      (hookL) arc[radius=2.5mm, start angle=90, end angle=-90] coordinate (hookR);
  \end{tikzpicture}%
  \par\vspace{4mm}%
}

% =============================================================================
% M5 · \dmexamplebadge{N}{제목} — 예제 배지 + U자 hook (수능특강 B1 재해석)
%   근거: 수능특강 p.5 · p.11 · p.41 (모든 예제 페이지 시그니처)
%   요소: 좌측 각진 배지 (`예제 N`) + 우측 얇은 라인 + U자 곡선 마감 (하향)
%   색 재해석: 짙은 녹색 → dm-primary 퍼플 · 라인 dm-rule 라벤더
%   폭: 배지 약 26mm × 8mm · 우측 라인 폭 = \linewidth - 배지 - subtitle
%   난이도: D2 (쉬움)
%   사용: \dmexamplebadge{1}{거듭제곱근}
%
%   기존 \dmex 와 차이점:
%     - \dmex : tcolorbox 라운드 배너 (콘텐츠 통 감쌈)
%     - \dmexamplebadge : 좌측 배지 + U자 hook (수능특강 시그니처 요소)
%   → 둘 다 채택 시 \dmexamplebadge 를 예제 시작에 · dmproblem 환경으로 발문 감쌈
%
%   v1.1 조정 (마스터 지적 [2]):
%     - hook 좌표를 \linewidth 상대 계산 (부제 텍스트 길이 자동 대응)
%     - 이전: `([xshift=\linewidth-1mm]bd.west|-bd.east)` (배지 기준 절대 좌표 · 부제 무시)
%     - 현재: `(current bounding box.east|-bd.east)` 상대 참조 · 부제 실제 폭 반영
% =============================================================================
\newcommand{\dmexamplebadge}[2]{%
  \par\vspace{7mm}\noindent
  \begin{tikzpicture}[baseline=(bd.base)]
    % 좌측 각진 배지 (예제 N)
    \node[
      top color=dm-primary, bottom color=dm-primarydark,
      rounded corners=1.5mm,
      inner xsep=4mm, inner ysep=2.5mm,
      minimum width=26mm, minimum height=8mm,
      font=\sffamily\bfseries, text=white,
      anchor=west,
      drop shadow={shadow xshift=0.3mm, shadow yshift=-0.3mm, fill=dm-shadow, opacity=0.6}
    ] (bd) at (0,0) {예제 #1};
    % 배지 우측 · 부제 텍스트 (라인 위에 배치)
    \node[right=3mm of bd.east, anchor=west, inner sep=0pt] (t) {%
      {\sffamily\bfseries\normalsize\color{dm-primary}#2}};
    % 부제 우측 → 얇은 라인 → U자 hook (하향 마감)
    % v1.1: 배지 좌측(0)에서 \linewidth 지점까지 절대 좌표로 hook 위치 계산
    %       (부제 t.east 뒤 라인이 \linewidth 를 초과하지 않도록)
    \draw[dm-rule, line width=0.5pt]
      ([xshift=4mm]t.east) --
      ([xshift=\linewidth-3mm]bd.west|-bd.east) coordinate (hookL);
    \draw[dm-rule, line width=0.5pt]
      (hookL) arc[radius=2.5mm, start angle=90, end angle=-90] coordinate (hookR);
  \end{tikzpicture}%
  \par\vspace{3mm}%
}

% =============================================================================
% M7 · \dmyujaebanner — 유제 리본 (수능특강 B5 재해석)
%   근거: 수능특강 p.5 · p.7 · p.11 · p.13 · p.41 (모든 유제 시작)
%   요소: 좌측 짙은 알약 (`유제`) + 우측 옅은 회색 얇은 밴드 (연장)
%   색 재해석: 짙은 녹색 → dm-primary · 회색 밴드 → dm-light 라벤더
%   폭: 좌측 알약 약 32mm × 7mm · 우측 밴드 = \linewidth 나머지 · 높이 약 4mm
%   M5 보다 작음 · 예제 다음 유제 zone 시각 진입점
%   난이도: D2 (쉬움)
%   사용: \dmyujaebanner
%
%   v1.1 조정 (마스터 지적 [3]):
%     - 알약 baseline 대칭 3mm × 2 (총 3mm 밴드) 재확인
%     - 밴드 y 좌표 -1.5mm ~ 1.5mm (대칭 3mm 폭) 유지
%     - 알약 (7mm 높이 · anchor=west · at (0,0)) baseline 정확히 y=0
%     - 결론: y-shift 조정 불필요 · 대칭 정합
% =============================================================================
\newcommand{\dmyujaebanner}{%
  \par\vspace{5mm}\noindent
  \begin{tikzpicture}[baseline=(yb.base)]
    % 우측 옅은 라벤더 얇은 밴드 (배경 · 먼저 그림 · 알약 baseline 대칭 3mm)
    \fill[dm-light]
      (0, -1.5mm) rectangle (\linewidth, 1.5mm);
    % 좌측 짙은 알약 (유제 · anchor=west · (0,0) 기준 · 밴드보다 크게 노출)
    \node[
      top color=dm-primary, bottom color=dm-primarydark,
      rounded corners=1.5mm,
      inner xsep=8mm, inner ysep=2mm,
      minimum width=30mm, minimum height=7mm,
      font=\sffamily\bfseries\normalsize, text=white,
      anchor=west
    ] (yb) at (0,0) {유제};
  \end{tikzpicture}%
  \par\vspace{3mm}%
}

% =============================================================================
% M8 · dmyujaelist 환경 — 세로 dot line + 원형 번호 배지 (수능특강 C1 재해석)
%   근거: 수능특강 p.5 · p.7 · p.11 · p.41 (유제 문항 사이 dot line)
%   요소: 각 \dmyujaeitem 좌측에 원형 배지 (`1`·`2`·`3` 등) · 문항 사이 세로 dot line
%   색 재해석: 짙은 녹색 → dm-primary · dot line → dm-primarydark 점
%   난이도: D3 (복잡 · overlay 계산 · 아이템 간 dot line 자동 배치)
%
%   v1.1 완성 (마스터 지적 [4]):
%     - remember picture + node reference 로 원형 배지 사이 세로 dot line 자동
%     - 각 배지에 고유 이름 부여 (dmyujaebadge-1·-2·-3...)
%     - 인접 배지 (N → N+1) 사이 dot line 그림 (원 중심-중심, 5~7 점)
%     - 페이지 넘김 시 다음 페이지 첫 배지는 이전 배지와 연결 안 됨 (자연 종료)
%     - 좌측 세로 dot 위치: 원형 배지 중심 (leftmargin 12mm 안 · x=-8mm 상대)
%
%   구현 상세:
%     - list 환경 · leftmargin 12mm 확보
%     - 각 \dmyujaeitem N 에서 (1) 원형 배지 (2) tikzmark 로 좌표 기록
%     - N ≥ 2 이면 이전 배지 (dmyujaebadge-\the\prev) 와 세로 dot 그림
%     - dot: 원 반지름 4mm 이후~다음 원 반지름 4mm 이전 (양단 4mm 여유)
%
%   사용:
%     \begin{dmyujaelist}
%       \dmyujaeitem{1} [문항 1 본문]
%       \dmyujaeitem{2} [문항 2 본문]
%     \end{dmyujaelist}
% =============================================================================
\newcounter{dmyujaecnt}
\newsavebox{\dmyujaebadgebox}

\newenvironment{dmyujaelist}{%
  \setcounter{dmyujaecnt}{0}%
  \par\vspace{2mm}%
  \begin{list}{}{%
    \setlength{\leftmargin}{12mm}%
    \setlength{\rightmargin}{0pt}%
    \setlength{\labelwidth}{9mm}%
    \setlength{\labelsep}{3mm}%
    \setlength{\itemindent}{0pt}%
    \setlength{\listparindent}{0pt}%
    \setlength{\topsep}{0pt}%
    \setlength{\parsep}{4pt plus 1pt}%
    \setlength{\itemsep}{6mm}%
    \renewcommand{\makelabel}[1]{##1\hfil}%
  }%
}{%
  \end{list}\vspace{2mm}%
}

% \dmyujaeitem{N} — 원형 배지 라벨 + 이전 배지와 dot line overlay (N ≥ 2)
% remember picture 로 배지 노드 고유 이름 부여 · 다음 아이템에서 참조 가능
% 페이지 넘김 시 이전 페이지 노드 참조 실패 → dot line 자동 skip (예외처리)
\newcommand{\dmyujaeitem}[1]{%
  \stepcounter{dmyujaecnt}%
  \sbox{\dmyujaebadgebox}{%
    \tikz[remember picture, baseline=(dyi\arabic{dmyujaecnt}.base)]{%
      \node[circle,
            top color=dm-primary, bottom color=dm-primarydark,
            minimum size=8mm, inner sep=0pt,
            font=\sffamily\bfseries\small, text=white,
            drop shadow={shadow xshift=0.3mm, shadow yshift=-0.3mm, fill=dm-shadow, opacity=0.6}
      ] (dyi\arabic{dmyujaecnt}) {#1};%
    }%
  }%
  \item[\usebox{\dmyujaebadgebox}]%
  % dot line overlay: 이전 배지 (N-1) 와 현재 배지 (N) 를 세로 점선으로 연결
  % N ≥ 2 일 때만 · remember picture + overlay · 페이지 넘김 대응 (실패 시 skip)
  \ifnum\value{dmyujaecnt}>1
    \begin{tikzpicture}[remember picture, overlay]
      % 두 배지 중심축(x)에 dot 5개 · y 는 이전 south ~ 현재 north 사이 균등
      % $(a)!t!(b)$ 는 a→b 선형보간 (t=0 → a, t=1 → b) · TikZ calc 라이브러리
      \foreach \t in {0.15, 0.32, 0.5, 0.68, 0.85} {
        \fill[dm-primarydark]
          ($(dyi\the\numexpr\value{dmyujaecnt}-1\relax.south)!\t!(dyi\arabic{dmyujaecnt}.north)$)
          circle (0.55mm);
      }
    \end{tikzpicture}%
  \fi
}

% =============================================================================
% M2 · \dmframepage — 페이지 전체 회색 라운드 프레임 (수능특강 A2 재해석)
%   근거: 수능특강 p.4·p.6·p.8·p.10·p.36·p.40·p.70 개념 페이지 전 페이지
%   요소: 페이지 상하좌우 여백 안쪽 · 얇은 라운드 사각 프레임
%     - 상단 hook · 챕터 배지 우측(약 50~65mm)에 U자 절개 — 콘텐츠 진입감
%     - 개념 페이지 챕터 배지는 프레임 위로 삐져나옴 (z-index 상위)
%   색 재해석: gray!50 (원본 밝은 회색) → dm-rule 라벤더 · 톤 일관성
%   구현: shipout AtBeginShipout · 페이지 배경 오버레이
%   사용: 문서 preamble 에 \dmframepageon (전 페이지 적용) 또는 페이지 단위 토글
%   Phase 1 smoke-test: \dmframepageon 으로 전 페이지 적용 후 시각 확인
%   난이도: D2 (쉬움)
%
%   v1.1 조정 (마스터 지적 [5]):
%     - 상단 hook 좌표 이동 : (110mm, -8mm) → (55mm, -8mm)
%       챕터 배지 (14.4mm) + 단원명 (~30mm) 우측 · 실제 챕터 배지 우측 종단 대응
%     - hook 폭 20mm 유지 (55~75mm 구간)
%     - 챕터 배지는 top=22mm (배지 상단), 프레임 상단 y=-8mm 이므로
%       배지가 프레임 안 상단 여백에 자연스럽게 위치 (겹침 없음)
% =============================================================================
\RequirePackage{atbegshi}

% 프레임 활성 flag (default off)
\newif\ifdmframepage
\dmframepagefalse

% 활성/비활성 토글
\newcommand{\dmframepageon}{\dmframepagetrue}
\newcommand{\dmframepageoff}{\dmframepagefalse}

% shipout 훅 · flag on 상태에서만 프레임 그림
\AtBeginShipout{%
  \ifdmframepage
    \AtBeginShipoutUpperLeft{%
      \begin{tikzpicture}[remember picture, overlay]
        % 페이지 좌상단 (0,0) → 좌표계
        % 페이지 크기 A4 · 210mm × 297mm
        % 프레임: 좌우 여백 10mm · 상하 여백 8mm 안쪽
        %   → 좌측 10mm · 상단 -8mm · 우측 -10mm · 하단 8mm
        \begin{scope}[shift={(0,0)}]
          % 라운드 프레임 (상단 hook 를 위해 세 부분 분할)
          % 좌하단 방향으로 시계 반대로 : 좌상단 hook 좌 → 좌측 → 하단 → 우측 → 우상단 hook 우
          \draw[dm-rule, line width=0.4pt, rounded corners=3mm]
            (55mm, -8mm) -- (10mm, -8mm)
            -- (10mm, -289mm) -- (200mm, -289mm)
