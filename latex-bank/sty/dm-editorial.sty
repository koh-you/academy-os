\newlength{\dmhintw}
\newenvironment{dmapproach}{%
  \par\vspace{2mm}%
  % HINT. + 1.3mm 갭의 정확한 폭 실측
  \settowidth{\dmhintw}{{\dmheadingfont\fontsize{9.5}{12}\selectfont\bfseries HINT.}}%
  \addtolength{\dmhintw}{1.3mm}%
  \begin{list}{}{%
    \setlength{\leftmargin}{\dimexpr 6mm + \dmhintw\relax}%
    \setlength{\rightmargin}{6mm}%
    \setlength{\itemindent}{-\dmhintw}%
    \setlength{\labelwidth}{0mm}%
    \setlength{\labelsep}{0mm}%
    \setlength{\topsep}{0mm}%
    % v6.73 세션 77 (마스터 지시): 문장간 간격 확보 · parsep 확대
    \setlength{\parsep}{1.4mm plus 1.2mm minus 0mm}%
    \setlength{\itemsep}{0mm}%
    \setlength{\listparindent}{0mm}%
  }%
  \item[]%
  {\color{dm-accent}\dmheadingfont\fontsize{9.5}{12}\selectfont\bfseries\uppercase{hint.}}%
  \hspace{1.3mm}%
  \color{dm-muted}\fontsize{9.5}{13}\selectfont\itshape%
}{%
  \end{list}%
  \par\vspace{2mm}%
}

% =============================================================================
% [17] dmsolution — 풀이 (라벨 배지 · 세션 70 v6.66 리딩 레일 · 좌정렬 수식)
% =============================================================================
% v6.13: 풀이 · 소단원 헤더급 위계 (좌측 굵은 bar + 큰 텍스트 + 하단 진한 rule)
% v6.15: 본문 좌측 들여쓰기 · 문항 박스와 매칭
% v6.17: bar 정렬 정정 · \rule 로 baseline 정확 매칭 (12.5pt 텍스트 ascender 4mm)
% v6.66 세션 70 (2026-07-22): 리딩 레일 (2pt navy borderline west) · 좁은 우측 여백 (18mm)
%   + equation* 좌정렬 (4mm 인덴트) · 시각 집중도 개선 (마스터 A안 승인)
% v6.69 세션 70 (마스터 재조정): rail 이 \dmanswer 앞에서 종료 (tcolorbox 조기 close)
\newenvironment{dmsolution}{%
  \par\vspace{5mm}%
  \noindent
  % v6.76 세션 78 (마스터 지시): "풀이" 단어 앞 작은 사각 rule dm-navy → dm-accent 포인트 색
  {\color{dm-accent}\rule[-0.4mm]{3.5pt}{4.2mm}}%
  \hspace{3mm}%
  {\color{dm-navy}\fontsize{13.5}{16}\selectfont\bfseries 풀이}%
  \par
  \vspace{1.5mm}%
  {\color{dm-ruledark}\hrule height 0.5pt}%
  \vspace{2mm}%
  \color{dm-ink}%
  % v6.69: \dmanswer 호출 시 tcolorbox 를 먼저 close 하여 rail 이 답 앞에서 종료
  \gdef\dm@sol@answerdone{0}%
  \global\let\dm@sol@origanswer\dmanswer
  \gdef\dmanswer##1{%
    \end{tcolorbox}%
    \dm@sol@origanswer{##1}%
    \gdef\dm@sol@answerdone{1}%
  }%
  \begin{tcolorbox}[
    enhanced, breakable,
    boxsep=0pt, top=2mm, bottom=1mm, left=8mm, right=18mm,
    frame hidden, colback=white, colbacktitle=white,
    overlay={%
      \draw[dm-navy, line width=2pt]
        ([xshift=4.2mm]frame.north west) --
        ([xshift=4.2mm]frame.south west);
    },
    parbox=false,
  ]%
    % equation* 좌정렬 (3mm 인덴트 · 계단식 마지막 계단)
    % v6.77 세션 79 (마스터 지시): 예제 풀이 간격 확대 · equation* 앞뒤 여백 2.5mm
    \renewenvironment{equation*}{%
      \par\vspace{2.5mm}\noindent\hspace*{3mm}$\displaystyle%
    }{%
      $\par\vspace{2.5mm}%
    }%
    % v6.77 세션 79 : parskip 1.5ex → 2.2ex (예제 풀이 문장간 간격 확대)
    \setlength{\parskip}{2.2ex}%
    \setlength{\parindent}{0pt}%
    \setlength{\abovedisplayskip}{10pt plus 1pt minus 1pt}%
    \setlength{\belowdisplayskip}{10pt plus 1pt minus 1pt}%
    \setlength{\abovedisplayshortskip}{8pt plus 1pt}%
    \setlength{\belowdisplayshortskip}{8pt plus 1pt}%
    \setlength{\jot}{6pt}%
    \linespread{1.25}\selectfont%
}{%
  \ifnum\dm@sol@answerdone=0 \end{tcolorbox}\fi
  \global\let\dmanswer\dm@sol@origanswer
  \par\vspace{2mm}%
}

