\newfontfamily\dmheadingfont[BoldFont={Malgun Gothic Bold},%
  AutoFakeBold=2]{Malgun Gothic}
% v6.71 세션 70 (마스터 A안 승인 · 2026-07-22): 본문 한글 폰트 · UnBatang → Noto Serif KR
%   전 시리즈 본문·개념박스·힌트·풀이 통일 (헤딩 badges 는 Malgun 유지)
\setmainhangulfont[BoldFont={Noto Serif KR}, BoldFeatures={Weight=Bold}]{Noto Serif KR}
\RequirePackage[a4paper,top=22mm,bottom=22mm,left=22mm,right=22mm,%
                headheight=14pt,headsep=8mm,footskip=14mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{fancyhdr}
