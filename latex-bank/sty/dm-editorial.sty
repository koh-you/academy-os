  % Top rule (얇게 · 단일선)
  {\color{dm-navy}\hrule height 0.6pt}%
  \vspace{1.2mm}%
  % Masthead 라인 (No.NN 좌 + EXERCISE SERIES 우 · 소캡스 · 8.5pt)
  \noindent
  {\color{dm-accent}\fontsize{8.5}{10}\selectfont\bfseries No.\ifnum#1<10 0\fi#1}%
  \hfill
  {\color{dm-muted}\fontsize{8.5}{10}\selectfont\bfseries EXERCISE\ \ SERIES}%
  \par
  % v6.44: 마스트헤드 라인 ↔ 박스 사이 공간 제거 (직접 붙임)
  \vspace{-1mm}%
  % Main banner (v6.49: shadow 제거 · 순수 flat 배너)
  \begin{tcolorbox}[
    enhanced,
    colback=dm-navy, colframe=dm-navydark,
    boxrule=0.3pt, sharp corners,
    left=6mm, right=6mm, top=1.8mm, bottom=1.8mm,
    boxsep=0mm,
    interior style={left color=dm-navy,right color=dm-navydark},
  ]
  {\color{white}\fontsize{11.5}{13}\selectfont\bfseries LEVEL\ #1}%
  \hspace{2.5mm}%
  {\color{dm-rulelight}\fontsize{10.5}{12}\selectfont \textperiodcentered}%
  \hspace{2.5mm}%
  {\color{white}\fontsize{11.5}{13}\selectfont\bfseries%
    \ifcase#1\or 기초 연습\or 표준 연습\or 심화 연습\else 연습\fi}%
  \hfill
  {\color{dm-rulelight}\fontsize{9}{11}\selectfont\bfseries 12 문제}%
  \end{tcolorbox}%
  % v6.47: 하단 rule 박스에 밀착 (1.2mm → -1mm)
  % v6.52: 너무 밀착 · 살짝 벌림 (-1mm → 0.4mm)
  \vspace{0.4mm}%
  % v6.46: 하단 double rule (1페이지 챕터 스타일) · 얇은 선 포인트 컬러
  % v6.48: 포인트 라인 굵기 상향 (0.4pt → 0.9pt)
  % v6.50: 포인트 라인 다시 얇게 (0.9pt → 0.6pt)
  % v6.51: navy 굵기 · v6.54: gap 벌림 · v6.56: CHAPTER와 동일
  % v6.59: 반전 (accent 얇게 위 · navy 굵게 아래) · CHAPTER·continuation과 통일
  {\color{dm-accent}\hrule height 0.7pt}%
  \vspace{0.7mm}%
  {\color{dm-navy}\hrule height 1.5pt}%
  \vspace{4mm}%
}

% v6.58: dmlevelspace = 시안 A 채택 · 이어짐 페이지 상단 반전 double rule
