% =============================================================================
% [25] \dmoptioninline — 인라인 조건/보기 박스 (deep-math.sty §555 포팅)
% -----------------------------------------------------------------------------
% 사용: \dmoptioninline{ㄱ. X \quad ㄴ. Y \quad ㄷ. Z}
% v6.64 semantic 복원 (feedback_macro_migration_semantic_preservation 계기)
% 팔레트: dm-accent(old purple) → dm-paperdeep!40 · dm-gold → dm-navy (dmoptionbox와 통일)
% arc=1mm → sharp corners (v6.5 정책)
% =============================================================================
\newcommand{\dmoptioninline}[1]{%
  \par\smallskip
  \begin{tcolorbox}[
    enhanced,
    colback=dm-paperdeep!40, colframe=dm-navy,
    boxrule=0.4pt, sharp corners,
    left=6mm, right=3mm, top=1.5mm, bottom=1.5mm,
    boxsep=0mm,
    overlay={%
      \draw[dm-navy,line width=2pt]
        ([xshift=1pt]frame.north west) --
        ([xshift=1pt]frame.south west);
    },
  ]
  \color{dm-ink} #1
  \end{tcolorbox}%
  \par\smallskip
}

% =============================================================================
% [25] \dmkichul{출처} — 학평·기출 출처 배지 (deep-math.sty §506 포팅)
% -----------------------------------------------------------------------------
% 사용: \dmpnum{N}{\dmkichul{2022학년도 11월 고1 학평 19번} 본문...}
% v6 : rounded corners=1.2pt → sharp corners · dm-primary → dm-navy 팔레트
% =============================================================================
\newcommand{\dmkichul}[1]{%
  % v6.74 세션 77 (마스터 지시): 배지-문제 사이 간격 · raisebox 4mm → 7mm (과했음) → 5mm
  \smash{\raisebox{5mm}{\rlap{\hbox to \linewidth{\hfill\tikz[baseline=(x.base)]{
    \node[draw=dm-navy!40, sharp corners, inner sep=2pt, inner ysep=1.2pt,
          font=\footnotesize\sffamily, text=dm-navy!85, line width=0.4pt] (x) {#1};
  }}}}}%
}

% =============================================================================
% choices32 · choicesii · choicesv — 선택형 5보기 배치 (시험지 style.sty 이식 · v6.75 세션 77)
% =============================================================================
% choices32 : 3-2 두 줄 (좌표·분수 등 짧은 5개)
% choicesii : 2-2-1 (중간 길이 5개)
% choicesv  : 5줄 세로 (긴 부등식·긴 수식)
% 사용: \begin{choices32}{①본문}{②본문}{③본문}{④본문}{⑤본문}\end{choices32}
% =============================================================================
\newenvironment{choices32}[5]{%
  \par\medskip\noindent
  \begin{tabular*}{\linewidth}{@{\extracolsep{\fill}}lll@{}}
    \mbox{\small \textcircled{\scriptsize 1}\ #1} & \mbox{\small \textcircled{\scriptsize 2}\ #2} & \mbox{\small \textcircled{\scriptsize 3}\ #3} \\[8pt]
    \mbox{\small \textcircled{\scriptsize 4}\ #4} & \mbox{\small \textcircled{\scriptsize 5}\ #5} & \\
  \end{tabular*}%
}{\par\medskip}
\newenvironment{choicesii}[5]{%
  \par\medskip\noindent
  \begin{tabular}{@{}p{0.49\linewidth}@{\hskip 0.02\linewidth}p{0.49\linewidth}@{}}
    \mbox{\small \textcircled{\scriptsize 1}\ #1} & \mbox{\small \textcircled{\scriptsize 2}\ #2} \\[2pt]
    \mbox{\small \textcircled{\scriptsize 3}\ #3} & \mbox{\small \textcircled{\scriptsize 4}\ #4} \\[2pt]
    \mbox{\small \textcircled{\scriptsize 5}\ #5} & \\
  \end{tabular}%
}{\par\medskip}
\newenvironment{choicesv}[5]{%
  \par\medskip\noindent
  \begin{tabular}{@{}l@{}}
    \mbox{\small \textcircled{\scriptsize 1}\ #1} \\[2pt]
    \mbox{\small \textcircled{\scriptsize 2}\ #2} \\[2pt]
    \mbox{\small \textcircled{\scriptsize 3}\ #3} \\[2pt]
    \mbox{\small \textcircled{\scriptsize 4}\ #4} \\[2pt]
    \mbox{\small \textcircled{\scriptsize 5}\ #5} \\
  \end{tabular}%
}{\par\medskip}

% =============================================================================
% \dmsubprob — 소문항 (1)(2)(3) hangindent 처리 (v6.71 세션 77)
% -----------------------------------------------------------------------------
% 마스터 지시 : 소문항 번호 밑으로 텍스트 이어지면 가독성 저해
% 조치 : hangindent + hangafter=1 로 후속 줄 소문항 라벨 폭만큼 들여쓰기
% 사용 : \dmsubprob{1} 텍스트 (라벨 (1) + 오른쪽 텍스트 · 다음 줄은 hangindent)
% =============================================================================
\newcommand{\dmsubprob}[1]{%
  \par\noindent
  \hangindent=1.6em\hangafter=1
  \makebox[1.5em][l]{$(#1)$}\ignorespaces%
}

