% -----------------------------------------------------------------------------
% 사용: \dmcheck{1}{...문제...}
% =============================================================================
% v6.75 세션 77 (마스터 지시): 본편 문항 번호 자동 카운터 · dmcheck + dmpnum 통합
%   확인 1~12 · L1 13~24 · L2 25~36 · L3 37~39 · 실전 40~42 파일 전역 연속
\newcounter{dmproblemcount}\setcounter{dmproblemcount}{0}
\newcommand{\dmcheck}[2]{%
  \par\vspace{2mm}%
  \stepcounter{dmproblemcount}%
  \noindent
  \begin{minipage}[t]{9mm}%
    \color{dm-navy}\fontsize{11}{13}\selectfont\bfseries \ifnum\value{dmproblemcount}<10 0\fi\arabic{dmproblemcount}.%
  \end{minipage}%
  \begin{minipage}[t]{\dimexpr\linewidth - 9mm\relax}%
    % v6.73 세션 77 (마스터 지시) : 문장간 간격 확보 · linespread + parskip
    \linespread{1.25}\selectfont%
    \setlength{\parskip}{1.4mm plus 1.4mm minus 0mm}%
    \color{dm-ink} #2%
  \end{minipage}%
  % v6.63 (세션 69 semantic 복원): 옛 deep-math.sty §400 elastic vfill 복원
  \par\vspace*{0pt plus 1fill}%
}

% =============================================================================
% [21] \dmlevel — Level 배너 (딥 네이비 + 부제 · v6.4 재해석)
