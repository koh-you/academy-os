% v6.20: 시리즈명 정정 · DeeP Math → Deep:it (마스터 확인 · 세션 57 계승)
% 2026-09-26: 머리말 오른쪽의 시리즈명은 빼고, 꼬리말 왼쪽을 학원명으로 바꿨다(사용자 지시).
%   \dmseriesname 은 옛 문서가 참조할 수 있어 정의만 남긴다 — 머리·꼬리말은 더 쓰지 않는다.
%   학원이 달라지면 \dmacademyname 만 바꾼다(예전에는 꼬리말에 「공통수학2」가 박혀 있어
%   어떤 교재를 뽑아도 그 이름이 찍혔다 — 교재명은 머리말 왼쪽 \dmchapname 이 이미 보여준다).
\newcommand{\dmseriesname}{Deep{:}it}
\newcommand{\dmacademyname}{으뜸수학 고태영T}
\newcommand{\dmchapnum}{}
\newcommand{\dmchapname}{}
% v6.61 (세션 69): 대단원명 (마스트헤드 accent 라벨) · fallback "CHAPTER NN"
% 사용: \renewcommand{\dmchapunit}{I. 도형의 방정식} (preamble 또는 \dmchapter 전)
\newcommand{\dmchapunit}{}

% =============================================================================
% [3] 페이지 헤더·푸터
% =============================================================================
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
% v6.66 (세션 73): 헤더·푸터 폰트 형식 답지 (dm-answer-classic)와 정합
%   - fancyhead·fancyfoot 모두 \sffamily 통일 (serif UnBatang → sans-serif)
%   - 하단 푸터 스펙 그대로 답지 계승 (\small\bfseries\color{dm-navydark})
%   - 상단 헤더는 답지 상단과 동일 필체 (\sffamily), 콘텐츠(챕터명·Deep:it)는 유지
\fancyhead[L]{\sffamily\small\color{dm-muted}\dmchapnum\ \ \dmchapname}
\fancyhead[R]{}
\renewcommand{\headrule}{\hbox to\headwidth{\color{dm-rulelight}\leaders\hrule height 0.4pt\hfill}}
\fancyfoot[L]{\sffamily\small\bfseries\color{dm-navydark}\dmacademyname}
\fancyfoot[R]{\sffamily\bfseries\color{dm-navy}\thepage}

% v6.63 (세션 69): 챕터 첫 페이지 전용 스타일 — 헤더 텍스트 유지 · 가로 rule만 제거
% v6.64 정정 (마스터 지적): 헤더 텍스트 (챕터명·Deep:it) 삭제 금지 · 실선만 삭제
% v6.66 (세션 73): sans-serif 정합 반영
\fancypagestyle{dmchapterfirst}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\headrule}{}%
  \fancyhead[L]{\sffamily\small\color{dm-muted}\dmchapnum\ \ \dmchapname}%
  \fancyhead[R]{}%
  \fancyfoot[L]{\sffamily\small\bfseries\color{dm-navydark}\dmacademyname}%
  \fancyfoot[R]{\sffamily\bfseries\color{dm-navy}\thepage}%
}

% =============================================================================
% [4] \dmchapter — 챕터 헤더
% -----------------------------------------------------------------------------
% 사용: \dmchapter{01}{평면좌표}
% =============================================================================
\newcommand{\dmchapter}[2]{%
  \renewcommand{\dmchapnum}{#1}%
  \renewcommand{\dmchapname}{#2}%
  \thispagestyle{dmchapterfirst}%
  \vspace*{-10mm}%
  % v6.64.7 (세션 69): 배너 내부 축소 (top/bottom 3.5→2mm, fontsize 14/15→13/14pt)
  % + vspace* -12→-10mm 균형. concept 235mm 페이지 1 유지하면서 배너 위치도 자연스러움
  {\color{dm-navy}\hrule height 0.6pt}%
  \vspace{1mm}%
  \noindent
  {\color{dm-accent}\sffamily\dmheadingfont\fontsize{9}{11}\selectfont\bfseries \dmchapunit}%
  \hfill
  \par
  \vspace{0.3mm}%
  \begin{tcolorbox}[
    enhanced,
    colback=dm-navy, colframe=dm-navydark,
    boxrule=0.3pt, sharp corners,
    left=6mm, right=6mm, top=1.5mm, bottom=1.5mm,
    boxsep=0mm,
    interior style={left color=dm-navy,right color=dm-navydark},
  ]
  {\color{white}\dmheadingfont\fontsize{12}{14}\selectfont\bfseries CHAPTER\ \dmchapnum}%
  \hspace{3mm}%
  {\color{dm-rulelight}\fontsize{11}{13}\selectfont \textperiodcentered}%
  \hspace{3mm}%
  {\color{white}\fontsize{13}{15}\selectfont\bfseries #2}%
  \end{tcolorbox}%
  \vspace{0.4mm}%
  {\color{dm-accent}\hrule height 0.7pt}%
  \vspace{0.6mm}%
  {\color{dm-navy}\hrule height 1.5pt}%
  \vspace{1.5mm}%
}

% =============================================================================
% [5] \dmconcepthead — 개념 이어짐 페이지 헤더 (배너 없음, 여백만)
% -----------------------------------------------------------------------------
% 사용: \dmconcepthead (챕터 배너 없이 소단원 개념 이어짐)
% =============================================================================
% v6.75 (세션 78 · 마스터 지시): 개념박스 상단 y-오프셋을 \dmchapter 와 통일
%   기존: -4mm baseline + double rule ≈ 4.5mm below baseline
%   dmchapter: -10mm baseline + unit + 배너 + double rule ≈ 7.0mm below baseline
%   격차 ~2.5mm (마스터 시각 ~5mm) → 대단원 마스트헤드 라인 미러링으로 정합
%   설계 원칙:
%     - dmchapter line 133 의 chapter-unit-text 라인 재활용 (\dmchapunit accent · 9pt)
%     - 우측 "이어지는 개념" sffamily muted 마커 (콘텐츠 기능적 정보 · 순수 장식 아님)
%     - dmchapter 시각 그래머 미러링 (상단 hairline · unit 라인 · 반전 double rule)
%     - fontsize·컬러·spacing 모두 dmchapter 와 동일 계열
\newcommand{\dmconcepthead}{%
  % v6.76 세션 78 (마스터 지시): 개념 이어짐 페이지도 헤더 옅은 회색 rule 제거
  \thispagestyle{dmchapterfirst}%
  \vspace*{-10mm}%
  % 상단 hairline (dmchapter line 130 미러)
  {\color{dm-navy}\hrule height 0.6pt}%
  \vspace{1mm}%
  % 마스트헤드 라인: 좌 \dmchapunit (accent) · 우 "이어지는 개념" (muted)
  \noindent
  {\color{dm-accent}\sffamily\dmheadingfont\fontsize{9}{11}\selectfont\bfseries \dmchapunit}%
  \hfill
  \par
  \vspace{10mm}% v6.76 세션 78 (마스터 재지시 2): 개념 2가 아직 위 · 추가 하강 필요
  % 반전 double rule (v6.61 컨셉 유지 · dmchapter 아래 double rule 미러)
  {\color{dm-accent}\hrule height 0.7pt}%
  \vspace{0.6mm}%
  {\color{dm-navy}\hrule height 1.5pt}%
  \vspace{1.5mm}%
}

% =============================================================================
% [6] \dmbracket — 페이지 우측 정보 (사용 안 함 · 호환 stub)
% -----------------------------------------------------------------------------
% 사용: \dmbracket{6} (기존 파일 호환용 · 실제 시각 요소 없음)
% =============================================================================
\newcommand{\dmbracket}[1]{}

% =============================================================================
% [7] \dmsub — 소단원 헤더 (좌측 굵은 bar + 번호 + 한글)
% -----------------------------------------------------------------------------
% 사용: \dmsub{1}{두 점 사이의 거리}
% =============================================================================
% v6.72 세션 70: 소개념 hairline 구분선 (시안) · v6.73 마스터 지시로 hairline 제거 · 여백만 확대
%   "개념 박스 안에 가로 분할선은 넣지마" (2026-07-22)
% v6.74 세션 70: 개념 타이틀 ↔ 첫 소개념 간격 축소 (first-sub flag)
%   dmconcept 시작 시 flag=true → 첫 \dmsub 은 2mm, 이후는 8mm
\newif\ifdm@firstsub
\dm@firstsubfalse
\newcommand{\dmsub}[2]{%
  \ifdm@firstsub
    \vspace{2mm}%
    \dm@firstsubfalse
  \else
    \vspace{8mm}%
  \fi
  \noindent
  {\color{dm-golddark}\dmheadingfont\fontsize{12.5}{15}\selectfont\bfseries
    #1)}%
  \hspace{2.5mm}%
  {\color{dm-navy}\dmheadingfont\fontsize{12.5}{15}\selectfont\bfseries
    #2}\par
  \vspace{4mm}%
}

% =============================================================================
% [8] dmconcept — 개념 박스 (3-arg: [height]{section_num}{title})
% -----------------------------------------------------------------------------
% 좌측 굵은 네이비 bar (2.5pt) + 웜 오프화이트 배경 + fuzzy shadow
% 사용: \begin{dmconcept}[214mm]{1}{두 점 사이의 거리} ... \end{dmconcept}
% =============================================================================
% v6.11: 개념 박스 fixed size 최대화 · 페이지 꽉 차게
% - 기본 높이 214mm → 235mm (챕터 헤더 하단 ~13mm + concept box 235mm + 여유 ~5mm)
% - before/after skip 축소 (3→1mm, 6→2mm)
% - 마스터가 이 fixed height 기준으로 텍스트 분량 설계
\newenvironment{dmconcept}[3][235mm]{%
  \begin{tcolorbox}[
    enhanced,
    height=#1,
    valign=top,
    colback=dm-paper,
    colframe=dm-rule,
    boxrule=0.3pt,
    leftrule=2.5pt,
    overlay={%
      \draw[dm-navy,line width=2.5pt]
        ([xshift=1.25pt]frame.north west) --
        ([xshift=1.25pt]frame.south west);
    },
    sharp corners,
    left=6mm, right=6mm, top=6mm, bottom=6mm,
    boxsep=0mm,
    drop fuzzy shadow={dm-shadow},
    before skip=1mm,
    after skip=2mm,
    % v6.72 세션 77 (마스터 지시) : 본편 개념박스 가독성 확대
    %   linespread 1.15 → 1.25 · parskip 0.6mm → 1.4mm (문장간 여유)
    fontupper=\linespread{1.25}\selectfont,
  ]
  \setlength{\parskip}{1.4mm plus 1.6mm minus 0mm}%
  % 제목: 사각 번호 배지 + 한글 제목 (v6.5: 원형 → 직각)
  \noindent
  \tikz[baseline=(t.base)]{%
    \node[fill=dm-navy,inner sep=0mm,%
          minimum width=5.5mm,minimum height=5.5mm,%
          text=white,font=\dmheadingfont\fontsize{10}{10}\bfseries] (t) {#2};%
  }%
  \hspace{3mm}%
  {\color{dm-navy}\dmheadingfont\fontsize{12.5}{15}\selectfont\bfseries #3}\par
  \vspace{2mm}%
  {\color{dm-ruledark}\hrule height 0.6pt}%
  \vspace{4mm}%
  \dm@firstsubtrue%
}{%
  \end{tcolorbox}%
}

% =============================================================================
% [8.5] dmconceptcont — 개념 박스 이어짐 (title 없음 · 상단 rule 유지 · v6.77 세션 79)
% -----------------------------------------------------------------------------
% 사용: 한 개념이 두 페이지에 걸칠 때 두 번째 페이지에서 사용
% - 배지·제목 텍스트 삭제
% - 상단 hrule 유지 (배지·제목 대체 시각 앵커)
% - 그 외 스타일 dmconcept와 동일
% =============================================================================
\newenvironment{dmconceptcont}[1][235mm]{%
  \begin{tcolorbox}[
    enhanced,
    height=#1,
    valign=top,
    colback=dm-paper,
    colframe=dm-rule,
    boxrule=0.3pt,
    leftrule=2.5pt,
    overlay={%
      \draw[dm-navy,line width=2.5pt]
        ([xshift=1.25pt]frame.north west) --
        ([xshift=1.25pt]frame.south west);
    },
    sharp corners,
    left=6mm, right=6mm, top=6mm, bottom=6mm,
    boxsep=0mm,
    drop fuzzy shadow={dm-shadow},
    before skip=1mm,
    after skip=2mm,
    fontupper=\linespread{1.25}\selectfont,
  ]
  \setlength{\parskip}{1.4mm plus 1.6mm minus 0mm}%
  % v6.77 세션 79 (마스터 지시): 상단 rule 위 여백 추가 · 전체 콘텐츠 아래로 이동
  \vspace{8mm}%
  % 상단 rule (배지·제목 대체 시각 앵커)
  {\color{dm-ruledark}\hrule height 0.6pt}%
  \vspace{4mm}%
  \dm@firstsubtrue%
}{%
  \end{tcolorbox}%
}

% =============================================================================
% [9] \dmformula — 개념 박스 안 공식 강조 박스 (선택적 사용)
% =============================================================================
\newcommand{\dmformula}[1]{%
  \vspace{1mm}%
  \begin{center}
  \begin{tcolorbox}[
    enhanced,
    colback=white, colframe=dm-navy,
    boxrule=0.5pt, sharp corners,
    left=8mm, right=8mm, top=3mm, bottom=3mm,
    boxsep=0mm,
    width=\dimexpr\linewidth-6mm\relax,
    drop fuzzy shadow={dm-shadow!85},
  ]
  \centering \color{dm-ink}
  \(\displaystyle #1\)
  \end{tcolorbox}
  \end{center}
  \vspace{1mm}%
}

% =============================================================================
% [10] dmexample — 개념 안 소예제 (좌측 예 라벨 + 인라인 텍스트)
% -----------------------------------------------------------------------------
% 사용: \begin{dmexample} 두 점 A(1,2)... \end{dmexample}
% =============================================================================
\newenvironment{dmexample}{%
  \vspace{1.5mm}%
  \begin{list}{}{%
    \setlength{\leftmargin}{9mm}%
    \setlength{\rightmargin}{0mm}%
    \setlength{\topsep}{0mm}\setlength{\parsep}{0mm}%
    \setlength{\itemsep}{0mm}%
  }%
  \item[]%
  \hspace{-9mm}%
  \tikz[baseline=(e.base)]{%
    \node[draw=dm-golddark,line width=0.4pt,%
          inner xsep=1.5mm,inner ysep=0.4mm,%
          fill=dm-goldlight,%
          text=dm-golddark,font=\dmheadingfont\fontsize{8}{9}\selectfont\bfseries] (e) {예};%
  }%
  \hspace{2mm}%
  \color{dm-ink}%
}{%
  \end{list}%
  \vspace{1.5mm}%
}

% =============================================================================
% [11] dmnote — 참고 박스 (좌측 굵은 bar + 진한 경계 · v6.3)
% =============================================================================
\newenvironment{dmnote}{%
  \vspace{2mm}%
  \begin{tcolorbox}[
    enhanced,
    colback=dm-navylight,
    colframe=dm-ruledark,
    boxrule=0.25pt,
    leftrule=2pt,
    sharp corners,
    left=4mm, right=4mm, top=2.5mm, bottom=2.5mm,
    boxsep=0mm,
    overlay={%
      \draw[dm-navy,line width=2pt]
        ([xshift=1pt]frame.north west) --
        ([xshift=1pt]frame.south west);
    },
  ]
  \color{dm-ink}\fontsize{9.5}{12}\selectfont
  {\color{dm-navy}\dmheadingfont\bfseries 참고.\ \ }%
}{%
  \end{tcolorbox}%
  \vspace{2mm}%
}

% =============================================================================
% [12] dmexplain — 풀이 관점 / 해설 블록 (같은 스타일 · 라벨만 다름)
% =============================================================================
\newenvironment{dmexplain}{%
  \vspace{2mm}%
  \begin{tcolorbox}[
    enhanced,
    colback=dm-navylight,
    colframe=dm-ruledark,
    boxrule=0.5pt,
    leftrule=2pt,
    sharp corners,
    left=4mm, right=4mm, top=2.5mm, bottom=2.5mm,
    boxsep=0mm,
    overlay={%
      \draw[dm-golddark,line width=2pt]
        ([xshift=1pt]frame.north west) --
        ([xshift=1pt]frame.south west);
    },
  ]
  \color{dm-ink}\fontsize{9.5}{12}\selectfont
  {\color{dm-golddark}\dmheadingfont\bfseries 해설.\ \ }%
}{%
  \end{tcolorbox}%
  \vspace{2mm}%
}

% =============================================================================
% [13] dmoptionbox — 조건 (가)(나)(다) · 보기 ㄱ·ㄴ·ㄷ 감쌈
% =============================================================================
\newenvironment{dmoptionbox}{%
  \vspace{2mm}%
  \begin{tcolorbox}[
    enhanced,
