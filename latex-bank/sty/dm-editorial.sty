% =============================================================================
% [22] \dmpnum — Level 문제 (v6.33: A+B+C 디자인 요소 추가)
% A: 번호 dm-accent 붉은 포인트 컬러 확대 (11pt navy → 14pt accent)
% B: 별점 우측 자동 표시 (Level 1→★2 · Level 2→★3 · Level 3→★4)
% C: 문제 간 얇은 divider rule (dm-rulelight 0.2pt)
% =============================================================================
% v6.75 세션 77 (마스터 지시): 본편 문항 번호 자동 카운터 · dmcheck + dmpnum 통합
%   카운터 dmproblemcount 는 dmcheck 에서 초기화 (파일 첫 dmcheck 사용 시 1부터)
\newlength{\dmpnumw}
\newcommand{\dmpnum}[2]{%
  \par\vspace{2mm}%
  \stepcounter{dmproblemcount}%
  \needspace{40mm}%
  % 책 전체 4자리 번호(1000 이상 · 라이트쎈)는 9mm 에 안 들어가 Overfull 이 나므로 번호 칸을 넓힌다.
  \ifnum\value{dmproblemcount}>999 \setlength{\dmpnumw}{10.5mm}\else\setlength{\dmpnumw}{9mm}\fi
  \noindent
  \begin{minipage}[t]{\dmpnumw}%
    \color{dm-navy}\fontsize{11}{13}\selectfont\bfseries \ifnum\value{dmproblemcount}<10 0\fi\arabic{dmproblemcount}.%
  \end{minipage}%
  \begin{minipage}[t]{\dimexpr\linewidth - \dmpnumw\relax}%
    % v6.73 세션 77 : Level 문제도 문장간 간격 · linespread + parskip
    \linespread{1.25}\selectfont%
    \setlength{\parskip}{1.4mm plus 1.4mm minus 0mm}%
    \color{dm-ink} #2%
  \end{minipage}%
  \par\vspace*{0pt plus 1fill}%
}

