% dm-answer-classic.sty — 기존 style.sty(vB) 답지 디자인의 v6 팔레트 포팅
% ============================================================================
% 목적: 기존 시리즈물 답지 (style.sty vB 블루) 디자인 그대로 유지,
%       팔레트만 v6 editorial (navy·accent·paper), 모든 라운드 박스 → 직각.
%
% 변경 요약:
%   • vB-deep(#1E4A8F 네이비 블루) → dm-navy(#0A2540)
%   • vB-accent(#3A78D8 밝은 블루) → dm-accent(#B7211E 딥 버밀리언)
%   • vB-answer-rule(#D4A017 골드) → dm-accent(#B7211E)
%   • vB-warn(#9A3412 갈오렌지)     → dm-accent(#B7211E)
%   • vB-light(#E8EFF8 옅은 블루)   → dm-navylight(#E8EEF4)
%   • vB-warn-light(#FED7AA 피치)   → dm-accentpale(#F9E9E8 신규)
%   • 모든 rounded corners=Npt → sharp corners
%   • 모든 arc=Npt → arc=0pt
%   • 폰트·크기·간격·구조: **기존 vB 완전 유지**
%
% 제공 API (dm-editorial-answer.sty 와 이름 동일):
%   \dmanswerheader{title} · \dmsection[sub]{title}
%   dmquickgrid + \dmquick · \dmsoltitle{n}{intent}
%   dmanswerbox · dmcriticalpoint + \dmcplabel · dmothersolution
%   \dmanswersetup · \dmsolnote(선택) · \dmstep
% ============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dm-answer-classic}[2026/07/22 v8.0 DeeP Math Answer · Classic port]

\RequirePackage{kotex}
% v8.4 (2026-07-23 세션 75) : 마스터 재지시 "정답지 본문들 폰트도 문제지와 동일하게 바꾸고 싶어"
% → 본편 (dm-editorial.sty) 과 동일 setmainhangulfont 지정 · Noto Serif KR
% (v8.3 이전 시도는 취소된 이력이나 명시 재지시로 재적용 · 본문 스코프)
\RequirePackage{fontspec}
\setmainhangulfont[BoldFont={Noto Serif KR}, BoldFeatures={Weight=Bold}]{Noto Serif KR}
\RequirePackage[a4paper,top=20mm,bottom=20mm,left=18mm,right=18mm,
                headheight=21pt,headsep=6mm,footskip=12mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins}
\RequirePackage{fancyhdr}
\RequirePackage{amsmath,amssymb}
% 🔴 2026-08-04 세션 111 — 인라인 수식이 등호·이항연산자에서 끊기는 것을 막는다.
%    계기: 마스터 지적 「답지 5번 풀이에 수식이 중간에 줄바꿈이 일어나」.
%    실측 — 답지 3~11쪽에서 일곱 군데가 끊겼다. 문제지는 0건이었다.
%    까닭: templates/style.sty:54~55 에는 이 두 줄이 있는데 이 파일에는 없었다.
%          문제지는 style.sty 를, 답지는 이 파일을 쓴다. 그래서 답지만 끊겼다.
\binoppenalty=10000
\relpenalty=10000
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{setspace}
\RequirePackage{needspace}
\RequirePackage{multicol}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,shapes.geometric,positioning,calc}

